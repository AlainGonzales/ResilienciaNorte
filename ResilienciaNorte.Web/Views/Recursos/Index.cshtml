@model IEnumerable<ResilienciaNorte.Domain.ExistenciaAlmacen>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Almacén de Contingencia (BAH)";
    ViewData["ModulosTiempoReal"] = "Almacen";
    var almacen = ViewBag.AlmacenSeleccionado as ResilienciaNorte.Domain.Almacen;
    var categorias = ViewBag.Categorias as IEnumerable<string> ?? Enumerable.Empty<string>();
    string categoriaActual = ViewBag.CategoriaSeleccionada as string ?? string.Empty;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-box-seam text-primary"></i> Almacén de Contingencia (BAH)</h2>
        <p class="text-muted small mb-0"><i class="bi bi-geo-alt"></i> @(almacen?.RutaUbicacion ?? "Sin almacén seleccionado")</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Kardex" asp-route-almacenId="@almacen?.AlmacenId" class="btn btn-outline-dark shadow-sm">
                <i class="bi bi-journal-text me-1"></i> Kardex del Almacén
            </a>
        }
        <a asp-action="Solicitudes" asp-route-estado="Aprobada" class="btn btn-outline-danger shadow-sm">
            <i class="bi bi-truck me-1"></i> Despachos
        </a>
    </div>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success py-2 d-flex justify-content-between align-items-center" role="alert">
        <span><i class="bi bi-check-circle-fill me-1"></i> @TempData["MensajeExito"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger py-2 d-flex justify-content-between align-items-center" role="alert">
        <span><i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["MensajeError"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<!-- Filtros: se aplican al cambiar la selección -->
<form method="get" class="row g-2 align-items-center mb-3">
    <div class="col-12 col-md-7 col-xl-6">
        <select name="almacenId" asp-items="ViewBag.Almacenes" class="form-select form-select fw-semibold" onchange="this.form.submit()"></select>
    </div>
    <div class="col-12 col-md-5 col-xl-3">
        <select name="categoria" class="form-select" onchange="this.form.submit()">
            <option value="">Todas las categorías</option>
            @foreach (var c in categorias)
            {
                <option value="@c" selected="@(c == categoriaActual)">@c</option>
            }
        </select>
    </div>
</form>

<div class="small fw-bold text-muted mb-2">@Model.Count() registros</div>
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Bien Humanitario</th>
                    <th>Categoría</th>
                    <th>Unidad</th>
                    <th class="text-center">Stock Disponible</th>
                    <th class="text-center">Stock Mínimo</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Operaciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Este almacén no tiene existencias registradas.</td>
                    </tr>
                }
                @foreach (var r in Model)
                {
                    bool agotado = r.StockDisponible == 0;
                    bool bajoMinimo = !agotado && r.EsStockCritico();
                    string claseFila = agotado ? "table-danger" : bajoMinimo ? "table-warning" : "";
                    string claseStock = agotado ? "text-danger" : bajoMinimo ? "text-warning-emphasis" : "text-success";
                    <tr class="@claseFila">
                        <td class="fw-bold">
                            <span class="font-monospace small text-muted">@r.Recurso?.CodigoBAH</span>
                            <div>@r.Recurso?.Nombre</div>
                        </td>
                        <td><span class="badge bg-light text-dark border">@r.Recurso?.Categoria</span></td>
                        <td>@r.Recurso?.UnidadMedida</td>
                        <td class="text-center fw-bold @claseStock">@r.StockDisponible.ToString("N0")</td>
                        <td class="text-center text-muted">@r.StockMinimo.ToString("N0")</td>
                        <td class="text-center">
                            @if (agotado)
                            {
                                <span class="badge bg-danger"><i class="bi bi-x-octagon-fill"></i> Agotado</span>
                            }
                            else if (bajoMinimo)
                            {
                                <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle-fill"></i> Bajo mínimo</span>
                            }
                            else
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Abastecido</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalIngreso-@r.AlmacenId-@r.RecursoId" title="Registrar ingreso (compra, donación o sobrante)">
                                    <i class="bi bi-plus-lg"></i> Ingreso
                                </button>
                                @if (r.Almacen?.AlmacenPadreId != null && !User.IsInRole("LogisticoAlmacen"))
                                {
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalReabastecer-@r.AlmacenId-@r.RecursoId" title="Abastecer desde el nivel superior">
                                        <i class="bi bi-send"></i> Abastecer
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>

                    <!-- Modal Ingreso -->
                    <div class="modal fade" id="modalIngreso-@r.AlmacenId-@r.RecursoId" tabindex="-1">
                        <div class="modal-dialog modal-lg modal-dialog-centered">
                            <div class="modal-content shadow">
                                <form asp-action="RegistrarIngreso" method="post">
                                    <input type="hidden" name="almacenId" value="@r.AlmacenId" />
                                    <input type="hidden" name="recursoId" value="@r.RecursoId" />
                                    <div class="modal-header bg-success text-white">
                                        <h5 class="modal-title fs-6"><i class="bi bi-box-arrow-in-down"></i> Ingreso: @r.Recurso?.Nombre</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold">Tipo de operación:</label>
                                            <select name="tipoEntrada" class="form-select form-select-sm" required>
                                                <option value="Compra Directa Edil">Compra directa</option>
                                                <option value="Donación">Donación</option>
                                                <option value="Sobrante">Sobrante de operativo</option>
                                            </select>
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold">Cantidad (@r.Recurso?.UnidadMedida):</label>
                                            <input type="number" name="cantidad" min="1" class="form-control form-control-sm" required />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold">Entidad origen / proveedor:</label>
                                            <input type="text" name="entidadOrigen" placeholder="Ej: INDECI, Municipalidad, Donante" class="form-control form-control-sm" required />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold">Documento sustentatorio:</label>
                                            <input type="text" name="documento" placeholder="Ej: O/C N° 4512, Acta de recepción" class="form-control form-control-sm" required />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold">Concepto / glosa:</label>
                                            <input type="text" name="concepto" placeholder="Detalle de recepción" class="form-control form-control-sm" required />
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-floppy me-1"></i>Confirmar</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Modal Abastecimiento -->
                    @if (r.Almacen?.AlmacenPadreId != null)
                    {
                        <div class="modal fade" id="modalReabastecer-@r.AlmacenId-@r.RecursoId" tabindex="-1">
                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                <div class="modal-content shadow">
                                    <form asp-action="SolicitarReabastecimiento" method="post">
                                        <input type="hidden" name="almacenId" value="@r.AlmacenId" />
                                        <input type="hidden" name="recursoId" value="@r.RecursoId" />
                                        <div class="modal-header bg-danger text-white">
                                            <h5 class="modal-title fs-6"><i class="bi bi-send"></i> Abastecimiento: @r.Recurso?.Nombre</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="alert alert-warning small py-2 mb-2">
                                                La solicitud se emitirá a <strong>@r.Almacen?.AlmacenPadre?.Nombre</strong>.
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label small fw-bold">Cantidad requerida:</label>
                                                <input type="number" name="cantidad" min="1" class="form-control form-control-sm" required />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label small fw-bold">Justificación técnica EDAN:</label>
                                                <textarea name="justificacion" rows="3" placeholder="Motivo del déficit y afectación" class="form-control form-control-sm" required></textarea>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-floppy me-1"></i>Emitir solicitud</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
