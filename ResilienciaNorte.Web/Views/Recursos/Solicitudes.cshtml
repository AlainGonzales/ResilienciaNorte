@model IEnumerable<ResilienciaNorte.Domain.Solicitud>
@using ResilienciaNorte.Domain
@{
    ViewData["Title"] = "Solicitudes";
    ViewData["ModulosTiempoReal"] = "Almacen,Incidentes";
    var stock = ViewBag.Stock as Dictionary<int, int> ?? new Dictionary<int, int>();
    bool puedeAprobar = (bool)ViewBag.PuedeAprobar;
    bool puedeDespachar = (bool)ViewBag.PuedeDespachar;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-arrow-repeat text-danger"></i> Solicitudes</h3>
        <p class="text-muted small mb-0">Pedidos de bienes de las incidencias y abastecimientos de su almacén</p>
    </div>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success py-2 d-flex justify-content-between align-items-center" role="alert">
        <span><i class="bi bi-check-circle-fill me-1"></i> @TempData["MensajeExito"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger py-2 d-flex justify-content-between align-items-center" role="alert">
        <span><i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["MensajeError"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="d-flex flex-wrap gap-2 mb-3">
    @foreach (var (valor, texto) in new[] { ("", "Todas"), ("Pendiente", "Pendientes"), ("Aprobada", "Aprobadas"), ("Despachada", "Despachadas"), ("Rechazada", "Rechazadas") })
    {
        <a asp-action="Solicitudes" asp-route-estado="@valor" class="btn btn-sm @(ViewBag.EstadoFiltro == valor ? "btn-dark" : "btn-outline-secondary")">@texto</a>
    }
</div>
<div class="small fw-bold text-muted mb-2">@Model.Count() registros</div>
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Código</th>
                    <th>Tipo</th>
                    <th>Bien</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-center">Stock</th>
                    <th>Destino</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">No hay solicitudes para su almacén.</td>
                    </tr>
                }
                @foreach (var s in Model)
                {
                    int stockActual = stock.TryGetValue(s.SolicitudId, out var st) ? st : 0;
                    bool stockAlcanza = stockActual >= s.CantidadSolicitada;
                    <tr>
                        <td class="fw-bold small font-monospace">@s.CodigoSolicitud</td>
                        <td>
                            @if (s.Tipo == "Incidencia")
                            {
                                <span class="badge bg-danger">Incidencia</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">@s.Tipo</span>
                            }
                        </td>
                        <td>
                            <div class="fw-bold">@s.Recurso?.Nombre</div>
                            <div class="small text-muted">@s.Justificacion</div>
                        </td>
                        <td class="text-center fw-bold">@s.CantidadSolicitada.ToString("N0")</td>
                        <td class="text-center">
                            <span class="fw-bold @(s.Estado is "Pendiente" or "Aprobada" ? (stockAlcanza ? "text-success" : "text-danger") : "")">@stockActual.ToString("N0")</span>
                        </td>
                        <td class="small">
                            @if (s.IncidenciaId != null)
                            {
                                <span class="font-monospace fw-bold">@s.Incidencia?.Codigo</span>
                                <div class="text-muted">@s.AlmacenSolicitante?.Nombre</div>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@s.AlmacenSolicitante?.Nombre</span>
                                <div class="text-muted">Proveedor: @(s.AlmacenProveedor?.Nombre ?? "—")</div>
                            }
                        </td>
                        <td class="small">@s.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @switch (s.Estado)
                            {
                                case "Pendiente":
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                    break;
                                case "Aprobada":
                                    <span class="badge bg-info text-dark">Aprobada</span>
                                    break;
                                case "Despachada":
                                    <span class="badge bg-success">Despachada</span>
                                    break;
                                case "Rechazada":
                                    <span class="badge bg-danger">Rechazada</span>
                                    if (!string.IsNullOrWhiteSpace(s.MotivoRechazo))
                                    {
                                        <div class="small text-muted mt-1">@s.MotivoRechazo</div>
                                    }
                                    break;
                                default:
                                    <span class="badge bg-secondary">@s.Estado</span>
                                    break;
                            }
                        </td>
                        <td class="text-center">
                            @if (s.Estado == "Pendiente" && puedeAprobar)
                            {
                                <div class="btn-group btn-group-sm">
                                    <form asp-action="Aprobar" asp-route-id="@s.SolicitudId" method="post">
                                        <button type="submit" class="btn btn-success" @(stockAlcanza ? "" : "disabled") title="@(stockAlcanza ? "Aprobar" : "Stock insuficiente")">
                                            <i class="bi bi-check-lg"></i> Aprobar
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalRechazar"
                                            data-id="@s.SolicitudId" data-codigo="@s.CodigoSolicitud">
                                        <i class="bi bi-x-lg"></i> Rechazar
                                    </button>
                                </div>
                            }
                            else if (s.Estado == "Aprobada" && puedeDespachar)
                            {
                                <form asp-action="Despachar" asp-route-id="@s.SolicitudId" method="post"
                                      onsubmit="return confirm('¿Despachar esta solicitud? Se descontará del stock del almacén.');">
                                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-truck"></i> Despachar</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal para rechazar: el motivo es obligatorio -->
<div class="modal fade" id="modalRechazar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Rechazar" method="post">
                <input type="hidden" name="id" id="rechazarId" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fs-6">Rechazar solicitud <span id="rechazarCodigo"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <label for="motivoRechazo" class="form-label small fw-bold">Motivo *</label>
                    <textarea name="motivo" id="motivoRechazo" rows="3" maxlength="300" required class="form-control"
                              placeholder="Ej: stock reservado para otra emergencia"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="bi bi-arrow-left me-1"></i>Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-x-lg me-1"></i>Confirmar rechazo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalRechazar = document.getElementById("modalRechazar");
        modalRechazar.addEventListener("show.bs.modal", function (event) {
            const boton = event.relatedTarget;
            document.getElementById("rechazarId").value = boton.dataset.id;
            document.getElementById("rechazarCodigo").textContent = boton.dataset.codigo;
            document.getElementById("motivoRechazo").value = "";
        });
    </script>
}
