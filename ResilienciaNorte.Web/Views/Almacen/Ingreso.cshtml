@model ResilienciaNorte.Web.Models.IngresoAlmacenViewModel
@{
    ViewData["Title"] = "Registrar Ingreso al Almacén";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h2 class="fw-bold mb-0">
            <i class="bi bi-plus-circle-fill text-success me-2"></i> Registrar Ingreso al Almacén
        </h2>
        <p class="text-muted mb-0">Compra directa edil, donación o sobrante</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header card-header-resiliencia">
                <i class="bi bi-box-arrow-in-down-right me-2"></i> Datos del Ingreso
            </div>
            <div class="card-body p-4">

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-x-circle-fill me-2"></i>
                        <strong>Corrige los errores antes de continuar:</strong>
                        <ul class="mb-0 mt-1">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-action="Ingreso" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="DistritoId" class="form-label fw-semibold"></label>
                            <select asp-for="DistritoId" asp-items="Model.Distritos"
                                    class="form-select" id="selectDistrito">
                                <option value="">— Seleccione un distrito —</option>
                            </select>
                            <span asp-validation-for="DistritoId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="RecursoId" class="form-label fw-semibold"></label>
                            <select asp-for="RecursoId" asp-items="Model.Recursos" class="form-select">
                                <option value="">— Seleccione un recurso —</option>
                            </select>
                            <span asp-validation-for="RecursoId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Concepto" class="form-label fw-semibold"></label>
                            <select asp-for="Concepto"
                                    asp-items="ResilienciaNorte.Web.Models.IngresoAlmacenViewModel.ConceptosIngreso"
                                    class="form-select" id="selectConcepto">
                                <option value="">— Seleccione el concepto —</option>
                            </select>
                            <span asp-validation-for="Concepto" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Cantidad" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="Cantidad" type="number" min="1"
                                       class="form-control" placeholder="Ej. 50" />
                                <span class="input-group-text">unidades</span>
                            </div>
                            <span asp-validation-for="Cantidad" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6" id="campoDocumento">
                            <label asp-for="DocumentoReferencia" class="form-label fw-semibold"></label>
                            <input asp-for="DocumentoReferencia" class="form-control"
                                   placeholder="Ej. OC-2026-0045 / Acta Donación N°12" />
                            <span asp-validation-for="DocumentoReferencia" class="text-danger small"></span>
                            <div class="form-text text-muted" id="helpDocumento">
                                N° Orden de Compra, Acta de Donación o código de sobrante.
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EntidadOrigen" class="form-label fw-semibold"></label>
                            <input asp-for="EntidadOrigen" class="form-control"
                                   placeholder="Ej. Municipalidad / Cruz Roja / Almacén Nº3" />
                            <span asp-validation-for="EntidadOrigen" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-success shadow-sm px-4">
                            <i class="bi bi-floppy-fill me-1"></i> Registrar Ingreso
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Cambiar hint del campo documento según el concepto seleccionado
        const hints = {
            "CompraDirecta": "N° Orden de Compra Edil",
            "Donacion":      "N° Acta de Donación / Convenio",
            "Sobrante":      "Código de referencia del sobrante"
        };
        document.getElementById("selectConcepto").addEventListener("change", function () {
            const help = document.getElementById("helpDocumento");
            help.textContent = hints[this.value] ?? "N° Orden de Compra, Acta de Donación o código de sobrante.";
        });
    </script>
}
