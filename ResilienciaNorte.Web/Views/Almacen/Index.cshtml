@model IEnumerable<ResilienciaNorte.Domain.RecursoAlmacen>
@{
    ViewData["Title"] = "Almacén de Contingencia (BAH)";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-box-seam text-primary"></i> Almacén de Contingencia BAH</h2>
        <p class="text-muted small mb-0">Control de Existencias Físicas y Kardex Inmutable - Provincia de Trujillo</p>
    </div>
    <a asp-action="Solicitudes" class="btn btn-outline-primary">
        <i class="bi bi-arrow-repeat me-1"></i> Solicitudes de Reabastecimiento
    </a>
</div>

<!-- Filtros de Inventario -->
<div class="card shadow-sm border-0 mb-3 bg-light">
    <div class="card-body p-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <select name="distritoId" asp-items="ViewBag.Distritos" class="form-select form-select-sm">
                    <option value="">-- Todos los distritos custodios --</option>
                </select>
            </div>
            <div class="col-md-4">
                <select name="categoria" class="form-select form-select-sm">
                    <option value="">-- Todas las categorías --</option>
                    <option value="Defensa Ribereña">Defensa Ribereña</option>
                    <option value="Techo">Techo</option>
                    <option value="Equipamiento">Equipamiento</option>
                    <option value="Alimentos">Alimentos</option>
                    <option value="Abrigo">Abrigo</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-sm btn-secondary w-100"><i class="bi bi-funnel"></i> Filtrar Inventario</button>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Existencias -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="card-header-resiliencia">
                <tr>
                    <th>Código BAH</th>
                    <th>Bien de Ayuda Humanitaria</th>
                    <th>Categoría</th>
                    <th>Distrito Custodio</th>
                    <th class="text-center">Stock Actual</th>
                    <th class="text-center">Stock Mínimo</th>
                    <th class="text-center">Estado Stock</th>
                    <th class="text-center">Operaciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    bool esCritico = r.StockDisponible <= r.StockMinimo;
                    <tr class="@(esCritico ? "table-danger" : "")">
                        <td class="fw-bold small">@r.CodigoBAH</td>
                        <td class="fw-bold">@r.Nombre</td>
                        <td><span class="badge bg-light text-dark border">@r.Categoria</span></td>
                        <td><span class="badge bg-secondary">@r.Distrito?.Nombre</span></td>
                        <td class="text-center fw-bold fs-6">@r.StockDisponible @r.UnidadMedida</td>
                        <td class="text-center text-muted">@r.StockMinimo</td>
                        <td class="text-center">
                            @if (esCritico)
                            {
                                <span class="badge bg-danger"><i class="bi bi-exclamation-triangle-fill"></i> CRÍTICO</span>
                            }
                            else
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> ÓPTIMO</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Kardex" asp-route-id="@r.RecursoId" class="btn btn-sm btn-outline-info py-0 px-2" title="Ver Kardex">
                                <i class="bi bi-journal-text"></i> Kardex
                            </a>
                            <button class="btn btn-sm btn-outline-success py-0 px-2" data-bs-toggle="modal" data-bs-target="#modalIngreso-@r.RecursoId" title="Registrar Entrada">
                                <i class="bi bi-plus-lg"></i> Ingreso
                            </button>
                            @if (esCritico)
                            {
                                <button class="btn btn-sm btn-outline-danger py-0 px-2" data-bs-toggle="modal" data-bs-target="#modalReabastecer-@r.RecursoId" title="Reabastecimiento">
                                    <i class="bi bi-send"></i> Pedir
                                </button>
                            }
                        </td>
                    </tr>

                    <!-- Modal Ingreso -->
                    <div class="modal fade" id="modalIngreso-@r.RecursoId" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form asp-action="RegistrarIngreso" method="post">
                                    <input type="hidden" name="recursoId" value="@r.RecursoId" />
                                    <div class="modal-header bg-success text-white">
                                        <h5 class="modal-title fs-6">Ingreso a Almacén: @r.Nombre</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold">Tipo de Ingreso:</label>
                                            <select name="tipoEntrada" class="form-select form-select-sm" required>
                                                <option value="Compra Directa Edil">Compra Directa Edil</option>
                                                <option value="Donación">Donación Humanitaria</option>
                                                <option value="Sobrante">Sobrante de Operativo</option>
                                            </select>
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold">Cantidad (@r.UnidadMedida):</label>
                                            <input type="number" name="cantidad" min="1" class="form-control form-control-sm" required />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold">Entidad Origen / Proveedor:</label>
                                            <input type="text" name="entidadOrigen" class="form-control form-control-sm" required />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold">Documento Referencia (Orden / Acta):</label>
                                            <input type="text" name="documento" class="form-control form-control-sm" required />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold">Concepto / Detalle:</label>
                                            <input type="text" name="concepto" class="form-control form-control-sm" required />
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="submit" class="btn btn-success btn-sm">Confirmar Ingreso en Kardex</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Modal Reabastecimiento Subsidiario -->
                    <div class="modal fade" id="modalReabastecer-@r.RecursoId" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form asp-action="SolicitarReabastecimiento" method="post">
                                    <input type="hidden" name="recursoId" value="@r.RecursoId" />
                                    <div class="modal-header bg-danger text-white">
                                        <h5 class="modal-title fs-6">Solicitud Subsidiaria: @r.Nombre</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="alert alert-warning small mb-2">
                                            Al solicitar, la requisición escalará automáticamente a nivel <strong>Provincial o Regional</strong> según el canal subsidiario.
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold">Cantidad Requerida:</label>
                                            <input type="number" name="cantidad" min="1" class="form-control form-control-sm" required />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold">Justificación Técnica de Emergencia:</label>
                                            <textarea name="justificacion" rows="3" class="form-control form-control-sm" required></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="submit" class="btn btn-danger btn-sm">Emitir Solicitud con Alerta SignalR</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
</div>