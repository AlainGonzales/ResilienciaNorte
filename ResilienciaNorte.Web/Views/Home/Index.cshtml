@{
    ViewData["Title"] = "Portal Principal - COEP Trujillo";
    var misReportes = ViewBag.MisReportes as List<ResilienciaNorte.Domain.IncidenteEmergencia>;
    var usuario = ViewBag.UsuarioActual as ResilienciaNorte.Domain.UsuarioAplicacion;
    bool estaLogueado = User.Identity != null && User.Identity.IsAuthenticated;
}

<div class="container py-4">

    <!-- Mensajes de Notificación y Validaciones -->
    @if (TempData["ExitoRegistro"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["ExitoRegistro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorLogin"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorLogin"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorRegistro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorRegistro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- HERO PRINCIPAL -->
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border border-danger border-2 text-center">
        <h1 class="display-5 fw-bold text-dark mb-2">
            <i class="bi bi-shield-shaded text-danger"></i> ResilienciaNorte
        </h1>
        <p class="lead text-muted mx-auto" style="max-width: 760px;">
            Plataforma del Centro de Operaciones de Emergencia Provincial (COEP Trujillo) para el reporte rápido ciudadano y monitoreo táctico de riesgos de inundación pluvial y quebradas.
        </p>

        @if (!estaLogueado)
        {
            <!-- Botones de Acción para Visitante -->
            <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
                <a asp-controller="Incidentes" asp-action="Registrar" class="btn btn-danger btn-lg px-4 fw-bold shadow-sm">
                    <i class="bi bi-megaphone-fill me-2"></i> Reportar Emergencia Ahora
                </a>
                <button type="button" class="btn btn-outline-dark btn-lg px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalBuscarReporte">
                    <i class="bi bi-search me-2"></i> Consultar Estado de Mi Alerta
                </button>
            </div>
            <div class="mt-3">
                <small class="text-muted">
                    ¿Deseas monitorear el historial de todos tus reportes?
                    <a href="#" class="text-danger fw-bold" data-bs-toggle="modal" data-bs-target="#modalAuth">Inicia sesión o regístrate aquí</a>.
                </small>
            </div>
        }
        else
        {
            <!-- Panel Informativo de Sesión Activa -->
            <div class="mt-4 p-3 bg-white rounded-3 border d-inline-block shadow-sm text-start">
                <span class="text-muted small d-block">Sesión activa como:</span>
                <span class="fw-bold fs-5 text-dark"><i class="bi bi-person-check-fill text-success"></i> @usuario?.NombreCompleto</span>
                <span class="badge bg-secondary ms-2">DNI: @usuario?.Dni</span>
                <span class="badge bg-danger ms-1">@usuario?.NivelJurisdiccion</span>

                <div class="mt-3 d-flex gap-2">
                    <a asp-controller="Incidentes" asp-action="Registrar" class="btn btn-sm btn-danger fw-bold">
                        <i class="bi bi-plus-circle me-1"></i> Registrar Nuevo Reporte
                    </a>
                    <form asp-controller="Cuentas" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Cerrar Sesión</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <!-- BANDEJA DE REPORTES DEL CIUDADANO (HISTORIAL ASOCIADO AL DNI) -->
    @if (estaLogueado)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-folder2-open text-warning me-2"></i> Mis Reportes Registrados (DNI: @usuario?.Dni)</h5>
                <span class="badge bg-danger">@(misReportes?.Count ?? 0) Registros</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Código</th>
                            <th>Tipo de Evento</th>
                            <th>Distrito / Sector</th>
                            <th>Fecha</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Seguimiento</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (misReportes == null || !misReportes.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    No tienes reportes asociados a tu DNI actualmente.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in misReportes)
                            {
                                <tr>
                                    <td class="font-monospace fw-bold text-danger">@item.CodigoIncidente</td>
                                    <td class="fw-bold">@item.TipoEvento</td>
                                    <td>
                                        <span class="badge bg-secondary">@item.Distrito?.Nombre</span>
                                        <small class="text-muted d-block">@item.SectorCritico</small>
                                    </td>
                                    <td class="small">@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">
                                        <span class="badge @(item.Estado == "Reportado" ? "bg-warning text-dark" : "bg-success")">
                                            @item.Estado
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="Incidentes" asp-action="Seguimiento" asp-route-codigo="@item.CodigoIncidente" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-activity"></i> Ver en Vivo
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

<!-- MODAL 1: BÚSQUEDA RÁPIDA DE ALERTA INDIVIDUAL (ANÓNIMO CON PIN OTP) -->
<div class="modal fade" id="modalBuscarReporte" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <form asp-controller="Incidentes" asp-action="SolicitarOtp" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title fs-6 fw-bold">
                        <i class="bi bi-search text-danger me-2"></i> Consultar Estado de Mi Reporte
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="small text-muted mb-3">
                        Ingrese el código correlativo de su reporte y su DNI para generar un PIN de validación seguro de 30 segundos.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Código de Alerta *</label>
                        <input type="text" name="codigoIncidente" class="form-control text-uppercase font-monospace" placeholder="ALT-2026-0001" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">DNI del Informante *</label>
                        <input type="text" name="dni" maxlength="8" class="form-control" placeholder="43243516" required />
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger btn-sm px-3 fw-bold">
                        <i class="bi bi-key-fill me-1"></i> Validar con PIN OTP
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL 2: ACCESO Y REGISTRO CIUDADANO (LOGIN / REGISTRO) -->
<div class="modal fade" id="modalAuth" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <div class="modal-header bg-danger text-white py-2">
                <h5 class="modal-title fs-6 fw-bold"><i class="bi bi-person-circle me-2"></i> Acceso al Sistema</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <ul class="nav nav-pills nav-justified mb-3" id="authTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold" id="tab-login-btn" data-bs-toggle="pill" data-bs-target="#tab-login" type="button">
                            Iniciar Sesión
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" id="tab-registro-btn" data-bs-toggle="pill" data-bs-target="#tab-registro" type="button">
                            Registrarse
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="authTabsContent">
                    <!-- PESTAÑA: LOGIN -->
                    <div class="tab-pane fade show active" id="tab-login">
                        <form asp-controller="Cuentas" asp-action="Login" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Correo Electrónico o DNI:</label>
                                <input type="text" name="EmailODni" class="form-control form-control-sm" placeholder="ejemplo@correo.com o 43243516" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Contraseña:</label>
                                <input type="password" name="Password" class="form-control form-control-sm" placeholder="••••••••" required />
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" name="Recordarme" id="chkRecordar">
                                <label class="form-check-label small" for="chkRecordar">Recordar sesión</label>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-danger fw-bold">Ingresar</button>
                            </div>
                        </form>
                    </div>

                    <!-- PESTAÑA: REGISTRO CIUDADANO -->
                    <div class="tab-pane fade" id="tab-registro">
                        <form asp-controller="Cuentas" asp-action="RegistroCiudadano" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">DNI (8 dígitos) *</label>
                                    <input type="text" name="Dni" maxlength="8" class="form-control form-control-sm" placeholder="43243516" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Celular *</label>
                                    <input type="text" name="Telefono" maxlength="9" class="form-control form-control-sm" placeholder="983093027" required />
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Nombre Completo *</label>
                                <input type="text" name="NombreCompleto" class="form-control form-control-sm" placeholder="Nombres y Apellidos" required />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Correo Electrónico *</label>
                                <input type="email" name="Email" class="form-control form-control-sm" placeholder="correo@ejemplo.com" required />
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Contraseña *</label>
                                    <input type="password" name="Password" class="form-control form-control-sm" placeholder="••••••" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Confirmar *</label>
                                    <input type="password" name="ConfirmPassword" class="form-control form-control-sm" placeholder="••••••" required />
                                </div>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-success fw-bold">Crear Cuenta Ciudadana</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>