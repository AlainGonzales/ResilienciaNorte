@{
    ViewData["Title"] = "Centro de Operaciones y Servicios";
    var usuario = ViewBag.UsuarioActual as ResilienciaNorte.Domain.UsuarioAplicacion;
    string rol = ViewBag.RolPrincipal as string ?? "";
    bool estaLogueado = User.Identity != null && User.Identity.IsAuthenticated;
}

<div class="mt-2">

    <!-- Notificaciones del Sistema -->
    @if (TempData["ExitoRegistro"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 mb-3">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["ExitoRegistro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorLogin"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 mb-3">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["ErrorLogin"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!estaLogueado)
    {
        <!-- ══════════════════════════════════════════════════════════════════════════ -->
        <!-- 1. VISTA PÚBLICA DE ANCHO COMPLETO (SIN SESIÓN)                          -->
        <!-- ══════════════════════════════════════════════════════════════════════════ -->
        <div class="card shadow-sm border-0 mb-4 bg-white" style="border-left: 5px solid #dc2626 !important;">
            <div class="card-body p-4 p-lg-5">
                <span class="badge bg-danger mb-2 px-3 py-1 text-uppercase fw-bold">Defensa Civil Trujillo</span>
                <h1 class="display-6 fw-bold text-dark mb-3">
                    Sistema Provincial de Alerta Temprana y Resiliencia
                </h1>
                <p class="lead text-muted mb-4">
                    Monitoreo en tiempo real de quebradas, cuencas hídricas y atención logística de emergencia ante desbordes pluviales en los 11 distritos de la Provincia de Trujillo.
                </p>

                <div class="row g-4">
                    <div class="col-lg-6">
                        <h5 class="fw-bold text-dark mb-3">Nuestro Propósito</h5>
                        <p class="text-secondary">
                            Proteger la vida y los bienes de la población trujillana mediante un sistema integrado de alertas tempranas,
                            monitoreo constante de zonas de riesgo y respuesta logística coordinada ante emergencias por inundación pluvial.
                        </p>
                    </div>
                    <div class="col-lg-6">
                        <h5 class="fw-bold text-dark mb-3">Funcionalidades Principales</h5>
                        <ul class="list-unstyled text-secondary small">
                            <li class="mb-2"><i class="bi bi-check-circle text-danger me-2"></i> Reporte de emergencias en tiempo real desde cualquier dispositivo</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-danger me-2"></i> Validación de reportes con PIN OTP de seguridad</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-danger me-2"></i> Seguimiento del estado de reportes registrados</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-danger me-2"></i> Coordinación interinstitucional de respuesta</li>
                        </ul>
                    </div>
                </div>

                <div class="mt-4 p-3 bg-light rounded-2 border-start border-4 border-danger">
                    <h6 class="fw-bold text-dark mb-2">¿Cómo Reportar una Emergencia?</h6>
                    <p class="text-secondary small mb-0">
                        Utiliza el botón "Reporte de Emergencia" en la barra superior de navegación para reportar inmediatamente
                        cualquier desborde, inundación o situación de riesgo. Tu reporte será validado por nuestro equipo de operaciones
                        y se coordinarán las acciones correspondientes.
                    </p>
                </div>
            </div>
        </div>

        <!-- 3 Tarjetas de Servicios y Quebradas Críticas -->
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 bg-white">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-circle fs-3">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">Qda. San Ildefonso</h5>
                                <small class="text-muted">El Porvenir - Florencia - Trujillo</small>
                            </div>
                        </div>
                        <p class="text-secondary small mb-0">
                            Punto crítico de descarga de aguas y lodo hacia el cauce central de Trujillo. Monitoreo constante de diques y activación de alarmas vecinales.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 bg-white">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle fs-3">
                                <i class="bi bi-water"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">Qda. El León</h5>
                                <small class="text-muted">La Esperanza - Huanchaco</small>
                            </div>
                        </div>
                        <p class="text-secondary small mb-0">
                            Control de escorrentía hacia el borde costero y balneario de Huanchaco. Vigilancia preventiva ante desbordes en el sector El Trópico.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 bg-white">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle fs-3">
                                <i class="bi bi-box-seam-fill"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">Reserva BAH</h5>
                                <small class="text-muted">Almacén Central Provincial</small>
                            </div>
                        </div>
                        <p class="text-secondary small mb-0">
                            Disponibilidad inmediata de sacos terreros, calaminas, motobombas y kits alimentarios con control de kardex inmutable y balance territorial.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ══════════════════════════════════════════════════════════════════════════ -->
        <!-- 2. VISTA DE COMANDO FUNCIONARIO / ADMIN (ESTILO DASHBOARD PEOPLE SUCCESS)   -->
        <!-- ══════════════════════════════════════════════════════════════════════════ -->
        <div class="card shadow-sm border-0 mb-3 bg-white">
            <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-dark text-white rounded-circle p-2 px-3 fs-3">
                        <i class="bi bi-person-fill-gear"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-0">@usuario?.NombreCompleto</h4>
                        <div class="d-flex gap-2 align-items-center mt-1">
                            <span class="badge bg-danger">Rol: @rol</span>
                            <span class="badge bg-secondary">Jurisdicción: @usuario?.NivelJurisdiccion</span>
                            <span class="badge bg-light text-dark border">DNI: @usuario?.Dni</span>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Incidentes" asp-action="Index" class="btn btn-danger btn-sm px-3 fw-bold">
                        <i class="bi bi-broadcast me-1"></i> Ir al Monitoreo
                    </a>                    
                </div>
            </div>
        </div>

        @if (rol != "Ciudadano")
        {
            <!-- 4 KPIS EN FRANJA COMPLETA (OCUPAN EL 100% DEL ANCHO) -->
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm bg-white p-3 card-dashboard">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted fw-bold text-uppercase">Alertas Totales</small>
                                <div class="fs-stat text-dark mt-1">@ViewBag.TotalAlertas</div>
                            </div>
                            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 fs-3">
                                <i class="bi bi-journal-text"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm bg-white p-3 card-dashboard">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-danger fw-bold text-uppercase">Alertas Críticas</small>
                                <div class="fs-stat text-danger mt-1">@ViewBag.AlertasCriticas</div>
                            </div>
                            <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-3 fs-3">
                                <i class="bi bi-exclamation-octagon-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm bg-white p-3 card-dashboard">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted fw-bold text-uppercase">Familias Damnificadas</small>
                                <div class="fs-stat text-warning mt-1">@ViewBag.FamiliasImpactadas</div>
                            </div>
                            <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-3 fs-3">
                                <i class="bi bi-people-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm bg-white p-3 card-dashboard">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted fw-bold text-uppercase">Stock de Bienes BAH</small>
                                <div class="fs-stat text-success mt-1">@ViewBag.TotalBienesBAH</div>
                            </div>
                            <div class="bg-success bg-opacity-10 text-success p-3 rounded-3 fs-3">
                                <i class="bi bi-boxes"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TABLA DE MONITOREO RÁPIDO RECIENTE -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-clock-history text-danger me-2"></i> Últimas Emergencias Notificadas (Vista Operativa)</h6>                    
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Código</th>
                                <th>Tipo de Evento</th>
                                <th>Distrito / Quebrada</th>
                                <th>Familias</th>
                                <th>Fecha</th>
                                <th class="text-center">Severidad</th>
                                <th class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var ultimos = ViewBag.UltimosIncidentes as List<ResilienciaNorte.Domain.IncidenteEmergencia>;
                            }
                            @if (ultimos == null || !ultimos.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">No hay reportes recientes registrados.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in ultimos)
                                {
                                    <tr>
                                        <td class="font-monospace fw-bold text-danger">@item.CodigoIncidente</td>
                                        <td class="fw-bold">@item.TipoEvento</td>
                                        <td>
                                            <span class="badge bg-secondary">@item.Distrito?.Nombre</span>
                                            <small class="text-muted d-block">@item.SectorCritico</small>
                                        </td>
                                        <td class="fw-bold text-danger">@item.FamiliasAfectadas fam.</td>
                                        <td class="small">@item.FechaRegistro.ToString("dd/MM HH:mm")</td>
                                        <td class="text-center">
                                            <span class="badge @(item.Severidad == "Crítico" ? "bg-danger" : "bg-warning text-dark")">@item.Severidad</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @(item.Estado == "Constatado" ? "bg-primary" : "bg-warning text-dark")">@item.Estado</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <!-- TABLA DEL CIUDADANO (SI ES ROL CIUDADANO) -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-folder2-open text-warning me-2"></i> Mis Reportes Registrados (DNI: @usuario?.Dni)</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Código</th>
                                <th>Tipo de Evento</th>
                                <th>Distrito / Sector</th>
                                <th>Fecha</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Seguimiento</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var misReportes = ViewBag.MisReportes as List<ResilienciaNorte.Domain.IncidenteEmergencia>;
                            }
                            @if (misReportes == null || !misReportes.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No has emitido reportes con tu DNI hasta el momento.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in misReportes)
                                {
                                    <tr>
                                        <td class="font-monospace fw-bold text-danger">@item.CodigoIncidente</td>
                                        <td class="fw-bold">@item.TipoEvento</td>
                                        <td>
                                            <span class="badge bg-secondary">@item.Distrito?.Nombre</span>
                                            <small class="text-muted d-block">@item.SectorCritico</small>
                                        </td>
                                        <td class="small">@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-center">
                                            <span class="badge @(item.Estado == "Reportado" ? "bg-warning text-dark" : "bg-success")">@item.Estado</span>
                                        </td>
                                        <td class="text-center">
                                            <a asp-controller="Incidentes" asp-action="Seguimiento" asp-route-codigo="@item.CodigoIncidente" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-activity"></i> Ver en Vivo
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }

</div>

<!-- MODAL LOGIN / REGISTRO -->
<div class="modal fade" id="modalAuth" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <div class="modal-header bg-danger text-white py-2">
                <h5 class="modal-title fs-6 fw-bold"><i class="bi bi-person-circle me-2"></i> Acceso al Sistema</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <ul class="nav nav-pills nav-justified mb-3" id="authTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold" id="tab-login-btn" data-bs-toggle="pill" data-bs-target="#tab-login" type="button">
                            Iniciar Sesión
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" id="tab-registro-btn" data-bs-toggle="pill" data-bs-target="#tab-registro" type="button">
                            Registrarse
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="authTabsContent">
                    <div class="tab-pane fade show active" id="tab-login">
                        <form asp-controller="Cuentas" asp-action="Login" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Correo Electrónico o DNI:</label>
                                <input type="text" name="EmailODni" class="form-control form-control-sm" placeholder="admin@coep.gob.pe o 00000001" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Contraseña:</label>
                                <input type="password" name="Password" class="form-control form-control-sm" placeholder="••••••••" required />
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" name="Recordarme" id="chkRecordar">
                                <label class="form-check-label small" for="chkRecordar">Recordar sesión</label>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-danger fw-bold">Ingresar</button>
                            </div>
                        </form>
                    </div>

                    <div class="tab-pane fade" id="tab-registro">
                        <form asp-controller="Cuentas" asp-action="RegistroCiudadano" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">DNI (8 dígitos) *</label>
                                    <input type="text" name="Dni" maxlength="8" class="form-control form-control-sm" placeholder="43243516" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Celular *</label>
                                    <input type="text" name="Telefono" maxlength="9" class="form-control form-control-sm" placeholder="983093027" required />
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Nombre Completo *</label>
                                <input type="text" name="NombreCompleto" class="form-control form-control-sm" placeholder="Nombres y Apellidos" required />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Correo Electrónico *</label>
                                <input type="email" name="Email" class="form-control form-control-sm" placeholder="correo@ejemplo.com" required />
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Contraseña *</label>
                                    <input type="password" name="Password" class="form-control form-control-sm" placeholder="••••••" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Confirmar *</label>
                                    <input type="password" name="ConfirmPassword" class="form-control form-control-sm" placeholder="••••••" required />
                                </div>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-success fw-bold">Crear Cuenta Ciudadana</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>