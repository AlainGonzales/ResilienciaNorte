@model ResilienciaNorte.Domain.IncidenteEmergencia
@{
    ViewData["Title"] = "Reportar Emergencia Ciudadana";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow border-0">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Reporte Ciudadano / Brigada de Emergencia</h5>
                <small>Centro de Operaciones de Emergencia Provincial - Trujillo</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Registrar" method="post" id="formReporte">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <h6 class="fw-bold text-secondary border-bottom pb-2 mb-3">1. Datos del Informante</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="DniCiudadano" class="form-label small fw-bold">DNI (8 dígitos) *</label>
                            <input asp-for="DniCiudadano"
                                   id="txtDni"
                                   class="form-control solo-numeros"
                                   maxlength="8"
                                   inputmode="numeric"
                                   placeholder="43243516"
                                   required />
                            <span asp-validation-for="DniCiudadano" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="NombreCiudadano" class="form-label small fw-bold">Nombre Completo *</label>
                            <input asp-for="NombreCiudadano"
                                   id="txtNombre"
                                   class="form-control solo-letras"
                                   placeholder="Nombres y Apellidos"
                                   required />
                            <span asp-validation-for="NombreCiudadano" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Telefono" class="form-label small fw-bold">Teléfono Celular *</label>
                            <input asp-for="Telefono"
                                   id="txtTelefono"
                                   class="form-control solo-numeros"
                                   maxlength="9"
                                   inputmode="numeric"
                                   placeholder="983093027"
                                   required />
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>
                    </div>

                    <h6 class="fw-bold text-secondary border-bottom pb-2 mb-3">2. Ubicación y Magnitud del Incidente</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="DistritoId" class="form-label small fw-bold">Distrito Afectado *</label>
                            <select asp-for="DistritoId" asp-items="ViewBag.Distritos" class="form-select" required>
                                <option value="">-- Seleccionar Distrito --</option>
                            </select>
                            <span asp-validation-for="DistritoId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SectorCritico" class="form-label small fw-bold">Sector o Quebrada Crítica *</label>
                            <input asp-for="SectorCritico" class="form-control" placeholder="Ej: Sector Gran Chimú / Qda. San Ildefonso" required />
                            <span asp-validation-for="SectorCritico" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TipoEvento" class="form-label small fw-bold">Tipo de Evento *</label>
                            <select asp-for="TipoEvento" class="form-select" required>
                                <option value="Inundación Pluvial (Lluvias)">Inundación Pluvial (Lluvias)</option>
                                <option value="Desborde Quebrada San Ildefonso">Desborde Quebrada San Ildefonso</option>
                                <option value="Desborde Quebrada El León">Desborde Quebrada El León</option>
                                <option value="Desborde Quebrada San Carlos">Desborde Quebrada San Carlos</option>
                                <option value="Colapso de Red de Desagüe">Colapso de Red de Desagüe</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FamiliasAfectadas" class="form-label small fw-bold">N° Familias Afectadas Aprox. *</label>
                            <input asp-for="FamiliasAfectadas"
                                   id="txtFamilias"
                                   type="number"
                                   min="1"
                                   max="5000"
                                   class="form-control solo-numeros-positivos"
                                   placeholder="10"
                                   required />
                            <span asp-validation-for="FamiliasAfectadas" class="text-danger small"></span>
                        </div>

                        <!-- Bloque de Geolocalización y Botones -->
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="DireccionReferencia" class="form-label small fw-bold mb-0">Dirección Exacta y Geolocalización:</label>
                                <button type="button" class="btn btn-sm btn-outline-danger py-0" id="btnGps">
                                    <i class="bi bi-geo-alt-fill"></i> Usar mi GPS actual
                                </button>
                            </div>
                            <input asp-for="DireccionReferencia" id="txtDireccion" class="form-control" placeholder="Calle, número o coordenadas GPS" />

                            <!-- Botón para ver en Google Maps -->
                            <div class="mt-2 text-end">
                                <button type="button" id="btnVerMaps" class="btn btn-sm btn-outline-primary d-none">
                                    <i class="bi bi-map-fill me-1"></i> Ver ubicación en Google Maps
                                </button>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Descripcion" class="form-label small fw-bold">Descripción Detallada de la Situación *</label>
                            <textarea asp-for="Descripcion" rows="3" class="form-control" placeholder="Explique la gravedad, altura del agua y daños visibles..." required></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold">
                            <i class="bi bi-send-fill me-1"></i> Registrar Alerta
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── 1. Validaciones de Entrada en Vivo ─────────────────────────────────────

        document.querySelectorAll(".solo-numeros").forEach(input => {
            input.addEventListener("keydown", function (e) {
                if (['Backspace', 'Tab', 'ArrowLeft', 'ArrowRight', 'Delete', 'Enter'].includes(e.key) ||
                    (e.ctrlKey === true && ['a', 'c', 'v', 'x'].includes(e.key.toLowerCase()))) {
                    return;
                }
                if (!/^[0-9]$/.test(e.key)) {
                    e.preventDefault();
                }
            });

            input.addEventListener("input", function () {
                this.value = this.value.replace(/[^0-9]/g, '');
            });
        });

        document.querySelectorAll(".solo-numeros-positivos").forEach(input => {
            input.addEventListener("keydown", function (e) {
                if (['Backspace', 'Tab', 'ArrowLeft', 'ArrowRight', 'Delete', 'Enter'].includes(e.key) ||
                    (e.ctrlKey === true && ['a', 'c', 'v', 'x'].includes(e.key.toLowerCase()))) {
                    return;
                }
                if (!/^[0-9]$/.test(e.key) || e.key === '-' || e.key === 'e' || e.key === '.') {
                    e.preventDefault();
                }
            });

            input.addEventListener("input", function () {
                this.value = this.value.replace(/[^0-9]/g, '');
            });
        });

        document.querySelectorAll(".solo-letras").forEach(input => {
            input.addEventListener("keydown", function (e) {
                if (['Backspace', 'Tab', 'ArrowLeft', 'ArrowRight', 'Delete', 'Enter', ' '].includes(e.key) ||
                    (e.ctrlKey === true && ['a', 'c', 'v', 'x'].includes(e.key.toLowerCase()))) {
                    return;
                }
                if (!/^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]$/.test(e.key)) {
                    e.preventDefault();
                }
            });

            input.addEventListener("input", function () {
                this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]/g, '');
            });
        });

        // ── 2. Lógica de Geolocalización y Maps ───────────────────────────────────
        let ultimaLatitud = null;
        let ultimaLongitud = null;

        const btnGps = document.getElementById("btnGps");
        const btnVerMaps = document.getElementById("btnVerMaps");
        const txtDireccion = document.getElementById("txtDireccion");

        btnGps.addEventListener("click", function () {
            const btn = this;

            if (!navigator.geolocation) {
                alert("Su navegador o dispositivo no soporta geolocalización.");
                return;
            }

            const textoOriginal = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Obteniendo GPS...';

            const gpsOptions = {
                enableHighAccuracy: true,
                timeout: 12000,
                maximumAge: 0
            };

            navigator.geolocation.getCurrentPosition(
                (pos) => {
                    const lat = pos.coords.latitude;
                    const lng = pos.coords.longitude;
                    const precisionMetros = Math.round(pos.coords.accuracy);

                    ultimaLatitud = lat;
                    ultimaLongitud = lng;

                    const estaEnPeru = (lat <= 0.1 && lat >= -18.5) && (lng <= -68.0 && lng >= -81.5);
                    if (!estaEnPeru) {
                        alert(`Advertencia: La ubicación detectada (${lat.toFixed(4)}, ${lng.toFixed(4)}) parece estar fuera de Perú.`);
                    }

                    const textoGps = `[GPS: ${lat.toFixed(6)}, ${lng.toFixed(6)} | Precisión: ±${precisionMetros}m] `;
                    txtDireccion.value = textoGps + (txtDireccion.value.replace(/\[GPS:.*?\]\s*/g, '') || "");

                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-check-lg"></i> GPS Capturado';
                    btn.classList.replace("btn-outline-danger", "btn-success");

                    btnVerMaps.classList.remove("d-none");
                },
                (err) => {
                    btn.disabled = false;
                    btn.innerHTML = textoOriginal;

                    let mensaje = "No se pudo obtener la ubicación.";
                    switch (err.code) {
                        case err.PERMISSION_DENIED:
                            mensaje = "Permiso de ubicación denegado. Active los permisos en su navegador.";
                            break;
                        case err.POSITION_UNAVAILABLE:
                            mensaje = "Señal GPS no disponible en este dispositivo/red.";
                            break;
                        case err.TIMEOUT:
                            mensaje = "Tiempo de espera agotado al consultar GPS.";
                            break;
                    }
                    alert(mensaje);
                },
                gpsOptions
            );
        });

        btnVerMaps.addEventListener("click", function () {
            if (ultimaLatitud && ultimaLongitud) {
                const url = `https://www.google.com/maps?q=${ultimaLatitud},${ultimaLongitud}`;
                window.open(url, '_blank');
            } else {
                const match = txtDireccion.value.match(/\[GPS:\s*(-?\d+\.\d+),\s*(-?\d+\.\d+)/);
                if (match) {
                    const url = `https://www.google.com/maps?q=${match[1]},${match[2]}`;
                    window.open(url, '_blank');
                } else {
                    alert("No hay coordenadas GPS válidas para abrir en el mapa.");
                }
            }
        });
    </script>
}