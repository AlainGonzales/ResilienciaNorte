@model IEnumerable<ResilienciaNorte.Domain.IncidenteEmergencia>
@{
    ViewData["Title"] = "Monitoreo de Incidentes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-activity text-danger"></i> Monitoreo de Incidentes</h2>
        <p class="text-muted small">Alertas y emergencias pluviales reportadas en los distritos de Trujillo</p>
    </div>
    <a asp-action="Registrar" class="btn btn-danger shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Reportar Incidente
    </a>
</div>

<!-- Filtros de búsqueda -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body bg-light py-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <label class="form-label small fw-bold text-muted">Filtrar por Distrito:</label>
                <select name="distritoId" asp-items="ViewBag.Distritos" class="form-select">
                    <option value="">-- Todos los distritos --</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold text-muted">Estado:</label>
                <select name="estado" class="form-select">
                    <option value="">-- Todos los estados --</option>
                    <option value="Pendiente" selected="@(ViewBag.EstadoSeleccionado == "Pendiente")">Pendiente</option>
                    <option value="En Evaluación" selected="@(ViewBag.EstadoSeleccionado == "En Evaluación")">En Evaluación</option>
                    <option value="Atendido" selected="@(ViewBag.EstadoSeleccionado == "Atendido")">Atendido</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-secondary w-100 me-2"><i class="bi bi-funnel"></i> Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Incidentes -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="card-header-resiliencia">
                <tr>
                    <th>Código</th>
                    <th>Incidente / Ubicación</th>
                    <th>Distrito</th>
                    <th>Tipo</th>
                    <th>Severidad</th>
                    <th>Familias</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">No se registran emergencias con los filtros seleccionados.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">#@item.Id</td>
                        <td>
                            <div class="fw-bold text-dark">@item.Titulo</div>
                            <small class="text-muted"><i class="bi bi-geo-alt"></i> @item.DireccionReferencia</small>
                        </td>
                        <td><span class="badge bg-secondary">@item.Distrito?.Nombre</span></td>
                        <td>@item.TipoDesastre</td>
                        <td>
                            @if (item.NivelSeveridad == "Crítico")
                            {
                                <span class="badge badge-critico px-2 py-1"><i class="bi bi-exclamation-octagon-fill"></i> Crítico</span>
                            }
                            else if (item.NivelSeveridad == "Alto")
                            {
                                <span class="badge badge-alto px-2 py-1"><i class="bi bi-exclamation-triangle-fill"></i> Alto</span>
                            }
                            else
                            {
                                <span class="badge badge-moderado px-2 py-1">Moderado</span>
                            }
                        </td>
                        <td class="fw-bold text-danger">@item.FamiliasAfectadas</td>
                        <td class="small">@item.FechaReporte.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <span class="badge @(item.Estado == "Pendiente" ? "bg-warning text-dark" : item.Estado == "En Evaluación" ? "bg-info text-dark" : "bg-success")">
                                @item.Estado
                            </span>
                        </td>
                        <td class="text-center">
                            @if (item.Estado != "Atendido")
                            {
                                <form asp-action="CambiarEstado" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="nuevoEstado" value="@(item.Estado == "Pendiente" ? "En Evaluación" : "Atendido")" />
                                    <button type="submit" class="btn btn-sm btn-outline-dark" title="Avanzar estado">
                                        @(item.Estado == "Pendiente" ? "Evaluar" : "Atender")
                                    </button>
                                </form>
                            }
                            else
                            {
                                <i class="bi bi-check2-all text-success fs-5"></i>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>