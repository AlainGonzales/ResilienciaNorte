    <!-- COLUMNA DERECHA: FILTRO DE ESTADO Y TABLA DE INCIDENTES -->
    <div class="col-xl-7 col-lg-7">
        <!-- Filtros compactos: Se eliminó el select de distritos redundante -->
        <div class="card shadow-sm border-0 mb-3 bg-light">
            <div class="card-body p-2">
                <form method="get" id="formFiltros" class="row g-2 align-items-center">
                    <!-- Distrito preservado en campo oculto para mantener la selección del SVG -->
                    <input type="hidden" name="distritoId" id="inputDistrito" value="@distritoActual" />

                    <div class="col-sm-8 col-md-9">
                        <select name="estado" id="selectEstado" class="form-select form-select-sm">
                            <option value="">-- Todos los estados --</option>
                            <!option value="Reportado" @(estadoActual == "Reportado" ? "selected" : "")>Reportado</!option>
                            <!option value="Constatado" @(estadoActual == "Constatado" ? "selected" : "")>Constatado</!option>
                            <!option value="Desestimado" @(estadoActual == "Desestimado" ? "selected" : "")>Desestimado</!option>
                            <!option value="Con Asignación" @(estadoActual == "Con Asignación" || estadoActual == "ConAsignacion" ? "selected" : "")>Con Asignación</!option>
                            <!option value="En Despacho" @(estadoActual == "En Despacho" || estadoActual == "EnDespacho" ? "selected" : "")>En Despacho</!option>
                            <!option value="Atendido" @(estadoActual == "Atendido" ? "selected" : "")>Atendido</!option>
                        </select>
                    </div>
                    <div class="col-sm-4 col-md-3 d-flex gap-1">
                        <button type="submit" class="btn btn-sm btn-secondary w-100"><i class="bi bi-funnel"></i> Filtrar</button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-2" title="Limpiar todos los filtros"><i class="bi bi-arrow-counterclockwise"></i></a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Tabla de alertas con scroll interno -->
        <div class="card shadow-sm border-0">
            <div class="table-responsive tabla-scroll-wrap">
                <table class="table table-hover align-middle mb-0" id="tablaIncidentes">
                    <thead class="card-header-resiliencia sticky-top">
                        <tr>
                            <th>Código</th>
                            <th>Incidente / Ubicación</th>
                            <th>Distrito</th>
                            <th>Severidad</th>
                            <th>Fam.</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th class="text-center">Acción</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyIncidentes">
                        @if (!Model.Any())
                        {
                            <tr id="filaSinRegistros">
                                <td colspan="8" class="text-center py-4 text-muted">No se registran emergencias con los filtros seleccionados.</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr data-distrito-id="@item.DistritoId">
                                <td class="fw-bold small">@item.CodigoIncidente</td>
                                <td>
                                    <div class="fw-bold small text-dark">@item.SectorCritico</div>
                                    <small class="text-muted"><i class="bi bi-geo-alt"></i> @(string.IsNullOrWhiteSpace(item.DireccionReferencia) ? item.TipoEvento : item.DireccionReferencia)</small>
                                </td>
                                <td><span class="badge bg-secondary">@item.Distrito?.Nombre</span></td>
                                <td>
                                    @if (item.Severidad == "Crítico")
                                    {
                                        <span class="badge badge-critico px-2 py-1"><i class="bi bi-exclamation-octagon-fill"></i> Crítico</span>
                                    }
                                    else if (item.Severidad == "Grave" || item.Severidad == "Alto")
                                    {
                                        <span class="badge badge-alto px-2 py-1"><i class="bi bi-exclamation-triangle-fill"></i> Grave</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-moderado px-2 py-1">Moderado</span>
                                    }
                                </td>
                                <td class="fw-bold text-danger">@item.FamiliasAfectadas</td>
                                <td class="small">@item.FechaRegistro.ToString("dd/MM HH:mm")</td>
                                <td>
                                    @switch (item.Estado)
                                    {
                                        case "Reportado":
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> Reportado</span>
                                            break;
                                        case "Constatado":
                                            <span class="badge bg-primary"><i class="bi bi-check-circle"></i> Constatado</span>
                                            break;
                                        case "Desestimado":
                                            <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Desestimado</span>
                                            break;
                                        case "Con Asignación":
                                        case "ConAsignacion":
                                            <span class="badge bg-info text-dark"><i class="bi bi-box-seam"></i> Asignado</span>
                                            break;
                                        case "En Despacho":
                                        case "EnDespacho":
                                            <span class="badge bg-secondary"><i class="bi bi-truck"></i> Despacho</span>
                                            break;
                                        case "Atendido":
                                            <span class="badge bg-success"><i class="bi bi-check2-all"></i> Atendido</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark">@item.Estado</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.Estado == "Reportado")
                                    {
                                        <form asp-action="CambiarEstado" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.IncidenteId" />
                                            <input type="hidden" name="nuevoEstado" value="Constatado" />
                                            <button type="submit" class="btn btn-sm btn-outline-success py-0 px-2" title="Constatar en terreno">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                        <form asp-action="CambiarEstado" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.IncidenteId" />
                                            <input type="hidden" name="nuevoEstado" value="Desestimado" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Desestimar reporte">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    }
                                    else if (item.Estado == "Constatado")
                                    {
                                        <a asp-controller="Ordenes" asp-action="Crear" asp-route-incidenteId="@item.IncidenteId" class="btn btn-sm btn-outline-primary py-0 px-2" title="Asignar bienes BAH">
                                            <i class="bi bi-box-seam"></i> Asignar
                                        </a>
                                    }
                                    else if (item.Estado == "Atendido")
                                    {
                                        <i class="bi bi-check2-all text-success fs-6" title="Emergencia Cerrada"></i>
                                    }
                                    else if (item.Estado == "Desestimado")
                                    {
                                        <i class="bi bi-slash-circle text-muted fs-6" title="Reporte Descartado"></i>
                                    }
                                    else
                                    {
                                        <a asp-controller="Ordenes" asp-action="PorIncidente" asp-route-id="@item.IncidenteId" class="badge bg-light text-dark border text-decoration-none" title="Ver orden de atención">En proceso</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Cliente oficial de SignalR desde CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        // 1. Interacción del Croquis SVG con el Formulario de Filtros
        document.querySelectorAll('.distrito-overlay').forEach(shape => {
            shape.addEventListener('click', function() {
                const distritoId = this.getAttribute('data-distrito');
                const inputDistrito = document.getElementById('inputDistrito');

                if (this.classList.contains('distrito-activo')) {
                    this.classList.remove('distrito-activo');
                    inputDistrito.value = "";
                } else {
                    document.querySelectorAll('.distrito-overlay').forEach(s => s.classList.remove('distrito-activo'));
                    this.classList.add('distrito-activo');
                    inputDistrito.value = distritoId;
                }

                document.getElementById('formFiltros').submit();
            });
        });

        // Resaltar el distrito en el SVG si ya viene filtrado en el request
        const distritoActualValor = document.getElementById('inputDistrito').value;
        if (distritoActualValor) {
            const poligono = document.getElementById(`dist-${distritoActualValor}`);
            if (poligono) poligono.classList.add('distrito-activo');
        }

        // 2. Conexión de SignalR con el EmergenciaHub
        const conexionHub = new signalR.HubConnectionBuilder()
            .withUrl("/emergenciaHub")
            .withAutomaticReconnect()
            .build();

        conexionHub.on("NuevoIncidenteReportado", function(data) {
            const filaVacia = document.getElementById('filaSinRegistros');
            if (filaVacia) filaVacia.remove();

            let badgeSeveridad = `<span class="badge badge-moderado px-2 py-1">Moderado</span>`;
            if (data.severidad === 'Crítico') {
                badgeSeveridad = `<span class="badge badge-critico px-2 py-1"><i class="bi bi-exclamation-octagon-fill"></i> Crítico</span>`;
            } else if (data.severidad === 'Grave' || data.severidad === 'Alto') {
                badgeSeveridad = `<span class="badge badge-alto px-2 py-1"><i class="bi bi-exclamation-triangle-fill"></i> Grave</span>`;
            }

            const nuevaFila = `
                <tr class="fila-reciente" data-distrito-id="${data.distritoId}">
                    <td class="fw-bold small">${data.codigo}</td>
                    <td>
                        <div class="fw-bold small text-dark">${data.sector}</div>
                        <small class="text-muted"><i class="bi bi-geo-alt"></i> ${data.referencia}</small>
                    </td>
                    <td><span class="badge bg-secondary">${data.distritoNombre}</span></td>
                    <td>${badgeSeveridad}</td>
                    <td class="fw-bold text-danger">${data.familias}</td>
                    <td class="small">${data.fecha}</td>
                    <td>
                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> ${data.estado}</span>
                    </td>
                    <td class="text-center">
                        <form action="/Incidentes/CambiarEstado" method="post" class="d-inline">
                            <input type="hidden" name="id" value="${data.incidenteId}" />
                            <input type="hidden" name="nuevoEstado" value="Constatado" />
                            <button type="submit" class="btn btn-sm btn-outline-success py-0 px-2" title="Constatar en terreno">
                                <i class="bi bi-check-lg"></i>
                            </button>
                        </form>
                        <form action="/Incidentes/CambiarEstado" method="post" class="d-inline">
                            <input type="hidden" name="id" value="${data.incidenteId}" />
                            <input type="hidden" name="nuevoEstado" value="Desestimado" />
                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Desestimar reporte">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            `;

            const tbody = document.getElementById('tbodyIncidentes');
            tbody.insertAdjacentHTML('afterbegin', nuevaFila);
        });

        conexionHub.start().catch(err => console.error("Error al iniciar conexión SignalR:", err));
    </script>
}