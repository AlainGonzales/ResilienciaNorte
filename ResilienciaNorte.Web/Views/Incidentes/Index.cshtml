    </div>

    <!-- COLUMNA DERECHA: FILTRO DE ESTADO Y TABLA DE INCIDENTES -->
    <div class="col-xl-8 col-lg-8">
        <div class="card shadow-sm border-0 mb-3 bg-light">
            <div class="card-body p-2">
                <form method="get" id="formFiltros">
                    <input type="hidden" name="distritoId" id="inputDistrito" value="@distritoActual" />
                    <input type="hidden" name="estado" value="@estadoActual" />

                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="small fw-bold text-muted me-1" style="min-width: 6rem;">Estado:</span>
                        @foreach (var (valor, etiqueta) in estados)
                        {
                            bool activo = estadoActual == valor;
                            <a asp-action="Index"
                               asp-route-estado="@(activo ? null : valor)"
                               asp-route-tipo="@tipoActual"
                               asp-route-distritoId="@distritoActual"
                               class="btn btn-sm @(activo ? "btn-dark" : "btn-outline-secondary")">@etiqueta</a>
                        }
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="small fw-bold text-muted me-1" style="min-width: 6rem;">Tipo:</span>
                        <select name="tipo" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                            <option value="">Todos los tipos</option>
                            @foreach (var t in tipos)
                            {
                                <option value="@t" selected="@(t == tipoActual)">@t</option>
                            }
                        </select>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            @if (User.IsInRole("Analista") || User.IsInRole("Administrador"))
            {
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 p-2 border-bottom">
                    <span class="small fw-bold text-muted ps-1"><span id="contadorReportes">@Model.Count()</span> registros</span>
                    <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-primary @((bool)ViewBag.PuedeCrearIncidencia ? "" : "d-none")" id="btnModoIncidencia" data-permitido="@((bool)ViewBag.PuedeCrearIncidencia ? "true" : "false")"><i class="bi bi-plus-lg"></i> Incidencia</button>
                    <button type="button" class="btn btn-sm btn-outline-primary d-none" id="btnSugerir"><i class="bi bi-magic"></i> Sugerir grupo (4 h)</button>
                    <button type="button" class="btn btn-sm btn-success d-none" id="btnCrearIncidencia" data-bs-toggle="modal" data-bs-target="#modalIncidencia" disabled>Crear incidencia (0)</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="btnCancelarModo">Cancelar</button>
                    </div>
                </div>

                <div class="modal fade" id="modalIncidencia" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content shadow">
                            <form asp-controller="Incidencias" asp-action="Crear" method="post" id="formCrearIncidencia">
                                <div class="modal-header bg-primary text-white">
                                    <h5 class="modal-title fs-6"><i class="bi bi-collection"></i> Nueva incidencia</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-2">
                                        <label class="form-label small fw-bold">Sector</label>
                                        <input type="text" name="sector" id="inputSectorIncidencia" class="form-control form-control-sm" maxlength="100" required />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small fw-bold">Tipo de evento</label>
                                        <select name="tipoEvento" id="selectTipoIncidencia" class="form-select form-select-sm" required>
                                            <option value="Inundación Pluvial">Inundación Pluvial</option>
                                            <option value="Desborde Quebrada">Desborde Quebrada</option>
                                            <option value="Colapso de Desagüe">Colapso de Desagüe</option>
                                        </select>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small fw-bold">Observación (opcional)</label>
                                        <textarea name="observacion" rows="2" class="form-control form-control-sm" maxlength="300"></textarea>
                                    </div>
                                    <p class="small text-muted mb-0" id="textoReportesIncidencia"></p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal"><i class="bi bi-arrow-left me-1"></i>Cancelar</button>
                                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-floppy me-1"></i>Crear incidencia</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }

            @if (!(User.IsInRole("Analista") || User.IsInRole("Administrador")))
            {
                <div class="small text-muted px-3 pt-2"><span id="contadorReportes">@Model.Count()</span> registros</div>
            }

            <div class="modal fade" id="modalReporte" tabindex="-1">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content shadow">
                        <div class="modal-header bg-dark text-white">
                            <h5 class="modal-title fs-6" id="repTitulo"></h5>
                        </div>
                        <div class="modal-body">
                            <div class="row g-2" id="repCuerpo"></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive tabla-scroll-wrap">
                <table class="table table-hover align-middle mb-0" id="tablaIncidentes">
                    <thead class="table-dark sticky-top">
                        <tr>
                            <th class="col-seleccion d-none" style="width: 2.5rem;"><input type="checkbox" id="chkTodos" class="form-check-input" /></th>
                            <th>Código</th>
                            <th>Incidente / Ubicación</th>
                            <th>Distrito</th>
                            <th>Severidad</th>
                            <th>Fam.</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th>Sgte. Responsable</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyIncidentes">
                        @if (!Model.Any())
                        {
                            <tr id="filaSinRegistros">
                                <td colspan="8" class="text-center py-4 text-muted">No se registran emergencias con los filtros seleccionados.</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr data-distrito-id="@item.DistritoId">
                                <td class="col-seleccion d-none">
                                    @if (item.Estado == EstadoIncidente.Reportado && item.IncidenciaId == null)
                                    {
                                        <input type="checkbox" class="form-check-input chk-reporte" value="@item.IncidenteId" data-distrito="@item.DistritoId" data-tipo="@item.TipoEvento" data-fecha="@item.FechaRegistro.ToString("o")" data-sector="@item.SectorCritico" />
                                    }
                                </td>
                                <td class="fw-bold small">@item.CodigoIncidente <button type="button" class="btn btn-sm btn-link p-0 ms-1 text-primary" title="Ver reporte" onclick="verReporte(@item.IncidenteId)"><i class="bi bi-eye"></i></button></td>
                                <td>
                                    <div class="fw-bold small text-dark">@item.SectorCritico</div>
                                    <small class="text-muted"><i class="bi bi-geo-alt"></i> @(string.IsNullOrWhiteSpace(item.DireccionReferencia) ? item.TipoEvento : item.DireccionReferencia)</small>
                                </td>
                                <td><span class="badge bg-secondary">@item.Distrito?.Nombre</span><div class="small text-muted mt-1">@item.TipoEvento</div></td>
                                <td>
                                    @if (item.Severidad == "Crítico")
                                    {
                                        <span class="badge badge-critico px-2 py-1"><i class="bi bi-exclamation-octagon-fill"></i> Crítico</span>
                                    }
                                    else if (item.Severidad == "Grave" || item.Severidad == "Alto")
                                    {
                                        <span class="badge badge-alto px-2 py-1"><i class="bi bi-exclamation-triangle-fill"></i> Grave</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-moderado px-2 py-1">Moderado</span>
                                    }
                                </td>
                                <td class="fw-bold text-danger">@item.FamiliasAfectadas</td>
                                <td class="small">@item.FechaRegistro.ToString("dd/MM HH:mm")</td>
                                <td>
                                    @switch (item.Estado)
                                    {
                                        case "Reportado":
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> Reportado</span>
                                            break;
                                        case "Constatado":
                                            <span class="badge bg-primary"><i class="bi bi-check-circle"></i> Constatado</span>
                                            break;
                                        case "Desestimado":
                                            <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Desestimado</span>
                                            break;
                                        case "Asignado":
                                            <span class="badge bg-info text-dark"><i class="bi bi-person-check"></i> Asignado</span>
                                            break;
                                        case "Atendido":
                                            <span class="badge bg-success"><i class="bi bi-check2-all"></i> Atendido</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark">@item.Estado</span>
                                            break;
                                    }
                                </td>
                                <td class="small fw-bold">@FlechaResponsable(item.Estado)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const reportesLista = @Html.Raw(Json.Serialize(Model.Select(i => new
        {
            id = i.IncidenteId,
            codigo = i.CodigoIncidente,
            distrito = i.Distrito?.Nombre,
            sector = i.SectorCritico,
            tipo = i.TipoEvento,
            severidad = i.Severidad,
            familias = i.FamiliasAfectadas,
            fecha = i.FechaRegistro.ToString("dd/MM/yyyy HH:mm"),
            direccion = i.DireccionReferencia,
            descripcion = i.Descripcion,
            nombre = i.NombreCiudadano,
            dni = i.DniCiudadano,
            telefono = i.Telefono,
            estado = i.Estado,
            motivo = i.Incidencia?.ObservacionResolucion,
            ficha = i.Incidencia?.FichaEdan == null ? null : new
            {
                familias = i.Incidencia.FichaEdan.FamiliasAfectadas,
                viviendas = i.Incidencia.FichaEdan.ViviendasAfectadas,
                personas = i.Incidencia.FichaEdan.PersonasAfectadas,
                fecha = i.Incidencia.FichaEdan.FechaVisita.ToString("dd/MM/yyyy"),
                necesidades = i.Incidencia.FichaEdan.NecesidadesUrgentes
            }
        })));
        const reportesMapa = {};
        reportesLista.forEach(r => reportesMapa[String(r.id)] = r);

        function verReporte(id) {
            const r = reportesMapa[String(id)];
            if (!r) return;
            document.getElementById('repTitulo').textContent = `Reporte ${r.codigo}`;
            const cuerpo = document.getElementById('repCuerpo');
            cuerpo.replaceChildren();
            const campos = [
                ['Distrito', r.distrito, 'col-md-6'],
                ['Sector / quebrada', r.sector, 'col-md-6'],
                ['Tipo de evento', r.tipo, 'col-md-6'],
                ['Severidad', r.severidad, 'col-md-6'],
                ['Familias afectadas', r.familias, 'col-md-6'],
                ['Fecha de registro', r.fecha, 'col-md-6'],
                ['Estado', r.estado, 'col-md-6'],
                ['Dirección / referencia', r.direccion, 'col-12'],
                ['Descripción', r.descripcion, 'col-12'],
                ['Informante', r.nombre, 'col-md-6'],
                ['DNI', r.dni, 'col-md-3'],
                ['Teléfono', r.telefono, 'col-md-3']
            ];
            if (r.motivo) campos.push(['Motivo de desestimación', r.motivo, 'col-12']);
            if (r.ficha) {
                campos.push(['Ficha EDAN · familias verificadas', r.ficha.familias, 'col-md-6']);
                campos.push(['Viviendas · personas', `${r.ficha.viviendas} viviendas · ${r.ficha.personas} personas`, 'col-md-6']);
                campos.push(['Fecha de visita', r.ficha.fecha, 'col-md-6']);
                campos.push(['Necesidades urgentes', r.ficha.necesidades ?? '—', 'col-12']);
            }
            campos.forEach(([etiqueta, valor, clase]) => {
                const col = document.createElement('div');
                col.className = clase;
                const label = document.createElement('label');
                label.className = 'form-label small fw-bold mb-0';
                label.textContent = etiqueta;
                const input = document.createElement('input');
                input.className = 'form-control form-control-sm';
                input.readOnly = true;
                input.value = valor ?? '—';
                col.append(label, input);
                cuerpo.append(col);
            });
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modalReporte')).show();
        }
    </script>

    <script>
        document.querySelectorAll('.distrito-overlay').forEach(shape => {
            shape.addEventListener('click', function() {
                const distritoId = this.getAttribute('data-distrito');
                const inputDistrito = document.getElementById('inputDistrito');

                if (this.classList.contains('distrito-activo')) {
                    this.classList.remove('distrito-activo');
                    inputDistrito.value = "";
                } else {
                    document.querySelectorAll('.distrito-overlay').forEach(s => s.classList.remove('distrito-activo'));
                    this.classList.add('distrito-activo');
                    inputDistrito.value = distritoId;
                }

                document.getElementById('formFiltros').submit();
            });
        });

        const distritoActualValor = document.getElementById('inputDistrito').value;
        if (distritoActualValor) {
            const poligono = document.getElementById(`dist-${distritoActualValor}`);
            if (poligono) poligono.classList.add('distrito-activo');
        }

        const conexionHub = new signalR.HubConnectionBuilder()
            .withUrl("/emergenciaHub")
            .withAutomaticReconnect()
            .build();

        conexionHub.on("NuevoIncidenteReportado", function(data) {
            reportesMapa[String(data.incidenteId)] = { id: data.incidenteId, codigo: data.codigo, distrito: data.distritoNombre, sector: data.sector, tipo: data.tipo, severidad: data.severidad, familias: data.familias, fecha: data.fecha, direccion: data.referencia, descripcion: data.descripcion, nombre: data.nombre, dni: data.dni, telefono: data.telefono, estado: data.estado };
            const contador = document.getElementById("contadorReportes");
            if (contador) contador.textContent = parseInt(contador.textContent, 10) + 1;
            const filaVacia = document.getElementById('filaSinRegistros');
            if (filaVacia) filaVacia.remove();

            let badgeSeveridad = `<span class="badge badge-moderado px-2 py-1">Moderado</span>`;
            if (data.severidad === 'Crítico') {
                badgeSeveridad = `<span class="badge badge-critico px-2 py-1"><i class="bi bi-exclamation-octagon-fill"></i> Crítico</span>`;
            } else if (data.severidad === 'Grave' || data.severidad === 'Alto') {
                badgeSeveridad = `<span class="badge badge-alto px-2 py-1"><i class="bi bi-exclamation-triangle-fill"></i> Grave</span>`;
            }

            const nuevaFila = `
                <tr class="fila-reciente" data-distrito-id="${data.distritoId}">
                    <td class="col-seleccion d-none"><input type="checkbox" class="form-check-input chk-reporte" value="${data.incidenteId}" data-distrito="${data.distritoId}" data-tipo="${data.tipo}" data-fecha="${data.fechaIso}" data-sector="${data.sector}" /></td>
                    <td class="fw-bold small">${data.codigo}</td>
                    <td>
                        <div class="fw-bold small text-dark">${data.sector}</div>
                        <small class="text-muted"><i class="bi bi-geo-alt"></i> ${data.referencia}</small>
                    </td>
                    <td><span class="badge bg-secondary">${data.distritoNombre}</span><div class="small text-muted mt-1">${data.tipo}</div></td>
                    <td>${badgeSeveridad}</td>
                    <td class="fw-bold text-danger">${data.familias}</td>
                    <td class="small">${data.fecha}</td>
                    <td>
                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> ${data.estado}</span>
                    </td>
                    <td class="small text-muted">${data.responsable ?? ""}</td>
                </tr>
            `;

            const tbody = document.getElementById('tbodyIncidentes');
            tbody.insertAdjacentHTML('afterbegin', nuevaFila);
        });

        const btnModo = document.getElementById('btnModoIncidencia');
        if (btnModo) {
            const btnSugerir = document.getElementById('btnSugerir');
            const btnCrear = document.getElementById('btnCrearIncidencia');
            const btnCancelar = document.getElementById('btnCancelarModo');
            const chkTodos = document.getElementById('chkTodos');
            const formIncidencia = document.getElementById('formCrearIncidencia');

            const seleccionados = () => [...document.querySelectorAll('.chk-reporte:checked')];

            function actualizarBarra() {
                const seleccion = seleccionados();
                const n = seleccion.length;
                // Una incidencia agrupa un solo tipo de evento
                const mezclados = new Set(seleccion.map(c => c.dataset.tipo)).size > 1;
                btnCrear.textContent = mezclados ? `Tipos distintos (${n})` : `Crear incidencia (${n})`;
                btnCrear.disabled = n === 0 || mezclados;
                btnCrear.title = mezclados ? "Los reportes deben ser del mismo tipo de evento" : "";
            }

            function modoSeleccion(activo) {
                document.querySelectorAll('.col-seleccion').forEach(c => c.classList.toggle('d-none', !activo));
                btnModo.classList.toggle('d-none', activo || btnModo.dataset.permitido !== 'true');
                btnSugerir.classList.toggle('d-none', !activo);
                btnCrear.classList.toggle('d-none', !activo);
                btnCancelar.classList.toggle('d-none', !activo);
                if (!activo) {
                    document.querySelectorAll('.chk-reporte').forEach(c => c.checked = false);
                    if (chkTodos) chkTodos.checked = false;
                }
                actualizarBarra();
            }

            btnModo.addEventListener('click', () => modoSeleccion(true));
            btnCancelar.addEventListener('click', () => modoSeleccion(false));

            if (chkTodos) chkTodos.addEventListener('change', () => {
                document.querySelectorAll('.chk-reporte').forEach(c => c.checked = chkTodos.checked);
                actualizarBarra();
            });

            document.getElementById('tbodyIncidentes').addEventListener('change', e => {
                if (e.target.classList.contains('chk-reporte')) actualizarBarra();
            });

            btnSugerir.addEventListener('click', async () => {
                const sel = seleccionados();
                if (sel.length === 0) {
                    alert('Marque primero un reporte de referencia.');
                    return;
                }
                const respuesta = await fetch(`/Incidencias/Sugerir?reporteId=${sel[0].value}`);
                const ids = await respuesta.json();
                const otros = ids.filter(id => String(id) !== sel[0].value);
                if (otros.length === 0) {
                    alert('No hay otros reportes del mismo distrito y tipo dentro de 4 horas del reporte marcado.');
                    return;
                }
                document.querySelectorAll('.chk-reporte').forEach(c => {
                    if (ids.includes(parseInt(c.value, 10))) c.checked = true;
                });
                actualizarBarra();
            });

            document.getElementById('modalIncidencia').addEventListener('show.bs.modal', () => {
                const sel = seleccionados();
                const primero = sel[0];
                document.getElementById('inputSectorIncidencia').value = primero ? primero.dataset.sector : '';
                if (primero) document.getElementById('selectTipoIncidencia').value = primero.dataset.tipo;
                document.getElementById('textoReportesIncidencia').textContent =
                    `${sel.length} reporte(s) se agruparán en esta incidencia.`;
            });

            formIncidencia.addEventListener('submit', () => {
                formIncidencia.querySelectorAll('input[name="reporteIds"]').forEach(i => i.remove());
                seleccionados().forEach(c => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'reporteIds';
                    input.value = c.value;
                    formIncidencia.appendChild(input);
                });
            });
        }

        conexionHub.start().catch(err => console.error("Error al iniciar conexión SignalR:", err));
    </script>
}