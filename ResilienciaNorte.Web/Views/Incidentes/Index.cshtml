@using ResilienciaNorte.Domain
@model IEnumerable<ResilienciaNorte.Domain.IncidenteEmergencia>
@{
    ViewData["Title"] = "Monitoreo de Reportes";
    ViewData["ModulosTiempoReal"] = "Incidentes";

    // El color de cada distrito sigue la severidad más alta de sus reportes activos
    var severidadMaximaPorDistrito = Model
        .Where(i => i.Estado != EstadoIncidente.Desestimado && i.Estado != EstadoIncidente.Atendido)
        .GroupBy(i => i.DistritoId)
        .ToDictionary(g => g.Key, g => g.Max(i => (int)NivelSeveridadExtensions.DesdeEtiqueta(i.Severidad)));

    string ObtenerColorSemaforo(int distritoId)
    {
        if (!severidadMaximaPorDistrito.TryGetValue(distritoId, out int nivel)) return string.Empty;
        if (nivel == (int)NivelSeveridad.Critico) return "alerta-rojo";
        if (nivel == (int)NivelSeveridad.Grave) return "alerta-naranja";
        return "alerta-amarillo";
    }

    var estados = new[]
    {
        (EstadoIncidente.Reportado, "Reportado"),
        (EstadoIncidente.Asignado, "Asignado"),
        (EstadoIncidente.Constatado, "Constatado"),
        (EstadoIncidente.Desestimado, "Desestimado"),
        (EstadoIncidente.Atendido, "Atendido")
    };

    string estadoActual = ViewBag.EstadoSeleccionado as string ?? "";
    string distritoActual = ViewBag.DistritoSeleccionado?.ToString() ?? "";
    string tipoActual = ViewBag.TipoSeleccionado as string ?? "";
    var tipos = ViewBag.Tipos as List<string> ?? new List<string>();


    string FlechaResponsable(string estado) => estado switch
    {
        EstadoIncidente.Reportado => "Analista",
        EstadoIncidente.Asignado => "Evaluador",
        EstadoIncidente.Constatado => "Coordinador",
        EstadoIncidente.Desestimado => "Descartado",
        EstadoIncidente.Atendido => "Cerrado",
        _ => ""
    };
}

<style>
    .mapa-card-container {
        background: #0f172a;
        border-radius: 12px;
        padding: 1.15rem;
        box-shadow: 0 4px 18px rgba(0,0,0,0.22);
    }

    .mapa-lienzo-wrap {
        position: relative;
        width: 100%;        
        margin: 0 auto;
        border-radius: 8px;
        overflow: hidden;
        background: #fff;
    }

    .mapa-svg {
        display: block;
        width: 100%;
        height: auto;
    }

    .distrito-overlay {
        cursor: pointer;
        fill: #e2e8f0;
        opacity: 0.6;
        stroke: #475569;
        stroke-width: 1.5;
        transition: stroke 0.15s ease-in-out, stroke-width 0.15s ease-in-out;
        pointer-events: all;
    }

    .distrito-overlay:hover {
        stroke: #0d6efd;
        stroke-width: 8;
    }

    .distrito-overlay.distrito-activo {
        stroke: #0d6efd;
        stroke-width: 8;
        filter: drop-shadow(0 0 4px #0d6efd);
    }

    .alerta-amarillo { fill: #facc15; }
    .alerta-naranja { fill: #fb923c; }
    .alerta-rojo { fill: #f87171; }

    .tabla-scroll-wrap {
        max-height: 540px;
        overflow-y: auto;
    }

    /* CORRECTO (Escapado para Razor) */
    @@keyframes filaNueva {
        from {
            background-color: #fef08a;
            transform: translateY(-4px);
        }
        to {
            background-color: transparent;
            transform: translateY(0);
        }
    }

    .fila-reciente {
        animation: filaNueva 3s ease-out;
    }
</style>

<div class="mb-3">
    <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-activity text-danger"></i> Monitoreo de Reportes</h2>
    <p class="text-muted small mb-0">Alertas y emergencias pluviales reportadas en la Provincia de Trujillo</p>
</div>

