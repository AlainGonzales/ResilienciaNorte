                          d="M 490,804 471,821 462,871 482,891 497,915 497,941 548,997 544,1025 554,1045 550,1066 564,1077 573,1092 572,1102 671,1229 678,1222 693,1185 715,1160 741,1155 761,1137 776,1138 785,1123 802,1108 818,1106 823,1099 843,1093 850,1086 847,1074 859,1053 853,1021 866,1010 867,1000 878,982 876,975 848,940 826,940 813,928 812,918 799,903 797,874 787,860 787,850 800,836 798,823 779,807 760,811 746,824 724,822 679,836 665,828 657,807 624,806 586,794 538,792 522,801 504,799 Z"
                          class="distrito-overlay @ObtenerColorSemaforo(8)"
