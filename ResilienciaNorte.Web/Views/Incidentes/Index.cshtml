@model IEnumerable<ResilienciaNorte.Domain.IncidenteEmergencia>
@{
    ViewData["Title"] = "Monitoreo de Incidentes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-activity text-danger"></i> Monitoreo de Incidentes</h2>
        <p class="text-muted small">Alertas y emergencias pluviales reportadas en los distritos de Trujillo</p>
    </div>
    <a asp-action="Registrar" class="btn btn-danger shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Reportar Incidente
    </a>
</div>

<!-- Filtros de búsqueda -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body bg-light py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-bold text-muted">Filtrar por Distrito:</label>
                <select name="distritoId" asp-items="ViewBag.Distritos" class="form-select">
                    <option value="">-- Todos los distritos --</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold text-muted">Estado:</label>
                <select name="estado" class="form-select">
                    <option value="">-- Todos los estados --</option>
                    <option value="Reportado" selected="@(ViewBag.EstadoSeleccionado == "Reportado")">Reportado</option>
                    <option value="Constatado" selected="@(ViewBag.EstadoSeleccionado == "Constatado")">Constatado</option>
                    <option value="Desestimado" selected="@(ViewBag.EstadoSeleccionado == "Desestimado")">Desestimado</option>
                    <option value="ConAsignacion" selected="@(ViewBag.EstadoSeleccionado == "ConAsignacion")">Con Asignación</option>
                    <option value="EnDespacho" selected="@(ViewBag.EstadoSeleccionado == "EnDespacho")">En Despacho</option>
                    <option value="Atendido" selected="@(ViewBag.EstadoSeleccionado == "Atendido")">Atendido</option>
                </select>
            </div>
            <div class="col-md-3 d-flex">
                <button type="submit" class="btn btn-secondary w-100 me-2"><i class="bi bi-funnel"></i> Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center justify-content-center px-3" title="Limpiar"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Incidentes -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="card-header-resiliencia">
                <tr>
                    <th>Código</th>
                    <th>Incidente / Ubicación</th>
                    <th>Distrito</th>
                    <th>Tipo</th>
                    <th>Severidad</th>
                    <th>Familias</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">No se registran emergencias con los filtros seleccionados.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.CodigoIncidente</td>
                        <td>
                            <div class="fw-bold text-dark">@item.SectorCritico</div>
                            <small class="text-muted"><i class="bi bi-geo-alt"></i> @(string.IsNullOrWhiteSpace(item.DireccionReferencia) ? "Sin referencia adicional" : item.DireccionReferencia)</small>
                        </td>
                        <td><span class="badge bg-secondary">@item.Distrito?.Nombre</span></td>
                        <td>@item.TipoEvento</td>
                        <td>
                            @if (item.Severidad == "Crítico")
                            {
                                <span class="badge badge-critico px-2 py-1"><i class="bi bi-exclamation-octagon-fill"></i> Crítico</span>
                            }
                            else if (item.Severidad == "Grave" || item.Severidad == "Alto")
                            {
                                <span class="badge badge-alto px-2 py-1"><i class="bi bi-exclamation-triangle-fill"></i> Grave</span>
                            }
                            else
                            {
                                <span class="badge badge-moderado px-2 py-1">Moderado</span>
                            }
                        </td>
                        <td class="fw-bold text-danger">@item.FamiliasAfectadas</td>
                        <td class="small">@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @switch (item.Estado)
                            {
                                case "Reportado":
                                    <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> Reportado</span>
                                    break;
                                case "Constatado":
                                    <span class="badge bg-primary"><i class="bi bi-check-circle"></i> Constatado</span>
                                    break;
                                case "Desestimado":
                                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Desestimado</span>
                                    break;
                                case "ConAsignacion":
                                    <span class="badge bg-info text-dark"><i class="bi bi-box-seam"></i> Con Asignación</span>
                                    break;
                                case "EnDespacho":
                                    <span class="badge bg-secondary"><i class="bi bi-truck"></i> En Despacho</span>
                                    break;
                                case "Atendido":
                                    <span class="badge bg-success"><i class="bi bi-check2-all"></i> Atendido</span>
                                    break;
                                default:
                                    <span class="badge bg-light text-dark">@item.Estado</span>
                                    break;
                            }
                        </td>
                        <td class="text-center">
                            @if (item.Estado == "Reportado")
                            {
                                <form asp-action="CambiarEstado" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.IncidenteId" />
                                    <input type="hidden" name="nuevoEstado" value="Constatado" />
                                    <button type="submit" class="btn btn-sm btn-outline-success me-1" title="Constatar en terreno">
                                        <i class="bi bi-check-lg"></i> Constatar
                                    </button>
                                </form>
                                <form asp-action="CambiarEstado" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.IncidenteId" />
                                    <input type="hidden" name="nuevoEstado" value="Desestimado" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Desestimar reporte">
                                        <i class="bi bi-x-lg"></i> Desestimar
                                    </button>
                                </form>
                            }
                            else if (item.Estado == "Constatado")
                            {
                                <span class="text-muted small"><i class="bi bi-arrow-right-circle"></i> Listo para Asignar</span>
                            }
                            else if (item.Estado == "Atendido")
                            {
                                <i class="bi bi-check2-all text-success fs-5" title="Emergencia Cerrada"></i>
                            }
                            else if (item.Estado == "Desestimado")
                            {
                                <i class="bi bi-slash-circle text-muted fs-6" title="Reporte Descartado"></i>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border">En proceso</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>