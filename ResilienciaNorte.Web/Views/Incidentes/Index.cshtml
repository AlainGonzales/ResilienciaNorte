@model IEnumerable<ResilienciaNorte.Domain.IncidenteEmergencia>
@{
    ViewData["Title"] = "Monitoreo de Incidentes";

    // Contadores por distrito para el semáforo inicial (excluye reportes desestimados)
    var conteoPorDistrito = Model
        .Where(i => i.Estado != "Desestimado")
        .GroupBy(i => i.DistritoId)
        .ToDictionary(g => g.Key, g => g.Count());

    string ObtenerColorSemaforo(int distritoId)
    {
        int count = conteoPorDistrito.ContainsKey(distritoId) ? conteoPorDistrito[distritoId] : 0;
        if (count >= 4) return "alerta-rojo";     // Situación crítica o alto impacto
        if (count >= 2) return "alerta-naranja";  // Alerta moderada / vigilancia
        return "alerta-amarillo";                 // Situación leve / preventiva
    }

    string estadoActual = ViewBag.EstadoSeleccionado as string ?? "";
    string distritoActual = ViewBag.DistritoSeleccionado?.ToString() ?? "";
}

<style>
    /* Panel lateral del Mapa Cartográfico */
    .mapa-card-container {
        background: #0f172a;
        border-radius: 12px;
        padding: 1.15rem;
        box-shadow: 0 4px 18px rgba(0,0,0,0.22);
    }

    .mapa-lienzo-wrap {
        position: relative;
        width: 100%;
        max-width: 480px;
        margin: 0 auto;
        border-radius: 8px;
        overflow: hidden;
        background: #fff;
    }

    .mapa-svg {
        display: block;
        width: 100%;
        height: auto;
    }

    /* Distritos interactivos */
    .distrito-overlay {
        cursor: pointer;
        opacity: 0.45;
        stroke: #1e293b;
        stroke-width: 2;
        transition: opacity 0.2s ease-in-out, stroke 0.2s ease-in-out, stroke-width 0.2s ease-in-out;
        pointer-events: all;
    }

        .distrito-overlay:hover {
            opacity: 0.80 !important;
            stroke: #0284c7 !important;
            stroke-width: 4 !important;
        }

        .distrito-overlay.distrito-activo {
            opacity: 0.90 !important;
            stroke: #0284c7 !important;
            stroke-width: 5 !important;
            filter: drop-shadow(0 0 6px #0284c7);
        }

    /* Semáforo Territorial Dinámico */
    .alerta-amarillo {
        fill: #eab308;
    }

    .alerta-naranja {
        fill: #f97316;
    }

    .alerta-rojo {
        fill: #ef4444;
    }

    /* Scroll interno para la grilla de alertas */
    .tabla-scroll-wrap {
        max-height: 540px;
        overflow-y: auto;
    }

    /* Animación de entrada SignalR */
    @@keyframes filaNueva {
        from {
            background-color: #fef08a;
            transform: translateY(-4px);
        }

        to {
            background-color: transparent;
            transform: translateY(0);
        }
    }

    .fila-reciente {
        animation: filaNueva 3s ease-out;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-activity text-danger"></i> Monitoreo de Incidentes</h2>
        <p class="text-muted small mb-0">Alertas y emergencias pluviales reportadas en la Provincia de Trujillo</p>
    </div>
    <a asp-action="Registrar" class="btn btn-danger shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Reportar Incidente
    </a>
</div>

