@model ResilienciaNorte.Domain.IncidenteEmergencia
@{
    ViewData["Title"] = "Registro Exitoso";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center">
        <div class="card shadow border-0 p-4">
            <div class="mb-3 text-success">
                <i class="bi bi-check-circle-fill display-1"></i>
            </div>
            <h3 class="fw-bold text-dark">¡Alerta Registrada con Éxito!</h3>
            <p class="text-muted">Su reporte ha sido enviado de inmediato al Centro de Operaciones de Emergencia Provincial (COEP).</p>

            <div class="alert alert-light border py-3 my-3">
                <small class="text-muted d-block">SU CÓDIGO DE SEGUIMIENTO ES:</small>
                <span class="fs-2 fw-bold text-danger font-monospace">@Model.CodigoIncidente</span>
            </div>

            <p class="small text-muted mb-4">Guarde este código. Con él y su DNI podrá consultar en cualquier momento el estado de atención mediante token OTP.</p>

            <div class="d-grid gap-2">
                <a asp-action="Seguimiento" asp-route-codigo="@Model.CodigoIncidente" class="btn btn-danger">
                    <i class="bi bi-activity"></i> Ir al Seguimiento en Vivo
                </a>
            </div>
        </div>
    </div>
</div>