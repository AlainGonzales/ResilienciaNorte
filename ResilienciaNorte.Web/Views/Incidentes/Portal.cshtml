        </div>
    </div>

    <script>
        // GPS para modal logueado
        const btnGpsLogueado = document.getElementById("btnGpsLogueado");
        const txtDireccionLogueado = document.getElementById("txtDireccionLogueado");
        const btnVerMapsLogueado = document.getElementById("btnVerMapsLogueado");
        let ultimaLatitudLogueado = null;
        let ultimaLongitudLogueado = null;

        if (btnGpsLogueado) {
            btnGpsLogueado.addEventListener("click", function () {
                if (!navigator.geolocation) {
                    alert("Su navegador no soporta geolocalización.");
                    return;
                }

                const btn = this;
                const textoOriginal = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Obteniendo GPS...';

