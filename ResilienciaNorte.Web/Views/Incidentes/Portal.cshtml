                                <input type="text" name="Telefono" value="@usuario?.PhoneNumber" class="form-control" readonly style="background-color: #f0f0f0; cursor: not-allowed;" />
                            </div>
                        </div>

                        <h6 class="fw-bold text-secondary border-bottom pb-2 mb-3">2. Ubicación y Magnitud</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Distrito Afectado *</label>
                                <select name="DistritoId" asp-items="ViewBag.Distritos" class="form-select form-select-sm" required>
                                    <option value="">-- Seleccionar Distrito --</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Sector/Quebrada *</label>
                                <input type="text" name="SectorCritico" class="form-control form-control-sm" placeholder="Ej: Sector Gran Chimú" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Tipo de Evento *</label>
                                <select name="TipoEvento" class="form-select form-select-sm" required>
                                    <option value="Inundación Pluvial (Lluvias)">Inundación Pluvial</option>
                                    <option value="Desborde Quebrada">Desborde Quebrada</option>
                                    <option value="Colapso de Red de Desagüe">Colapso de Desagüe</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">N° Familias Afectadas *</label>
                                <input type="number" name="FamiliasAfectadas" class="form-control form-control-sm" min="1" max="5000" placeholder="10" required />
                            </div>
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label small fw-bold mb-0">Dirección/Ubicación:</label>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-0" id="btnGpsLogueado">
