@{
    ViewData["Title"] = "Portal de Alertas y Emergencias";
    bool estaLogueado = User.Identity != null && User.Identity.IsAuthenticated;
    var misReportes = ViewBag.MisReportes as IEnumerable<ResilienciaNorte.Domain.IncidenteEmergencia>;
    var usuario = ViewBag.UsuarioActual as ResilienciaNorte.Domain.UsuarioAplicacion;
}

<div class="container py-4">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-dark"><i class="bi bi-shield-check text-danger"></i> Módulo de Reportes de Emergencia</h2>
        <p class="text-muted">Centro de Operaciones de Emergencia Provincial - Trujillo</p>
    </div>

    @if (!estaLogueado)
    {
        <!-- FLUJO PARA CIUDADANO NO LOGUEADO: 2 OPCIONES CLARAS -->
        <div class="row g-4 justify-content-center">
            <div class="col-md-5">
                <div class="card h-100 shadow-sm border-0 text-center p-4">
                    <div class="card-body">
                        <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3 d-inline-block mb-3 fs-1">
                            <i class="bi bi-megaphone-fill"></i>
                        </div>
                        <h4 class="fw-bold text-dark">Reportar Emergencia Ahora</h4>
                        <p class="text-muted small mb-4">
                            Emita un aviso urgente por desborde o aniego en su distrito. Se registrará con coordenadas GPS y se le otorgará un código correlativo oficial.
                        </p>
                        <button type="button" class="btn btn-danger btn-lg w-100 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalReportarEmergencia">
                            Iniciar Reporte Civil
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="card h-100 shadow-sm border-0 text-center p-4">
                    <div class="card-body">
                        <div class="bg-dark bg-opacity-10 text-dark rounded-circle p-3 d-inline-block mb-3 fs-1">
                            <i class="bi bi-search"></i>
                        </div>
                        <h4 class="fw-bold text-dark">Consultar Estado de Mi Alerta</h4>
                        <p class="text-muted small mb-4">
                            Si ya cuenta con un código (ALT-2026-XXXX) y no tiene cuenta, ingrese su DNI y genere un PIN OTP temporal para verificar el avance del auxilio.
                        </p>
                        <a asp-action="Consultar" class="btn btn-outline-dark btn-lg w-100 fw-bold">
                            Verificar con PIN OTP
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- FLUJO PARA CIUDADANO LOGUEADO: BANDEJA COMPLETA DE SUS REPORTES -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-folder2-open text-warning me-2"></i> Mis Alertas Registradas (DNI: @usuario?.Dni)
                    </h5>
                    <div class="d-flex gap-2">
                        <a asp-action="DescargarReportesPDF" class="btn btn-success btn-sm fw-bold">
                            <i class="bi bi-file-pdf me-1"></i> Descargar PDF
                        </a>
                        <button type="button" class="btn btn-danger btn-sm fw-bold" data-bs-toggle="modal" data-bs-target="#modalReportarEmergenciaLogueado">
                            <i class="bi bi-plus-circle me-1"></i> Nueva Emergencia
                        </button>
                    </div>
                </div>
            </div>

            <!-- Panel de Filtros -->
            <div class="card-body bg-light border-bottom">
                <form asp-action="Portal" method="get" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Buscar Código</label>
                        <input type="text" name="buscar" class="form-control form-control-sm" placeholder="ALT-2026-XXXX" value="@ViewBag.BusquedaActiva" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Estado</label>
                        <select name="estado" class="form-select form-select-sm">
                            <option value="">-- Todos los estados --</option>
                            @if (ViewBag.Estados != null)
                            {
                                @foreach (var est in ViewBag.Estados)
                                {
                                    <option value="@est" selected="@(est == ViewBag.EstadoSeleccionado)">@est</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Desde</label>
                        <input type="date" name="fechaDesde" class="form-control form-control-sm" value="@ViewBag.FechaDesde" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Hasta</label>
                        <input type="date" name="fechaHasta" class="form-control form-control-sm" value="@ViewBag.FechaHasta" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary btn-sm fw-bold w-100">
                            <i class="bi bi-search"></i> Filtrar
                        </button>
                        <a asp-action="Portal" class="btn btn-secondary btn-sm fw-bold">
                            <i class="bi bi-arrow-clockwise"></i>
                        </a>
                    </div>
                </form>
            </div>

            <!-- Indicador de Filtros Activos -->
            @if (!string.IsNullOrWhiteSpace(ViewBag.BusquedaActiva) || !string.IsNullOrWhiteSpace(ViewBag.EstadoSeleccionado) || !string.IsNullOrWhiteSpace(ViewBag.FechaDesde) || !string.IsNullOrWhiteSpace(ViewBag.FechaHasta))
            {
                <div class="alert alert-info mb-0 border-0 rounded-0 py-2 px-4 small">
                    <i class="bi bi-funnel me-2"></i><strong>Filtros aplicados:</strong>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.BusquedaActiva))
                    {
                        <span class="badge bg-info me-2">Código: @ViewBag.BusquedaActiva</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(ViewBag.EstadoSeleccionado))
                    {
                        <span class="badge bg-info me-2">Estado: @ViewBag.EstadoSeleccionado</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(ViewBag.FechaDesde))
                    {
                        <span class="badge bg-info me-2">Desde: @ViewBag.FechaDesde</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(ViewBag.FechaHasta))
                    {
                        <span class="badge bg-info">Hasta: @ViewBag.FechaHasta</span>
                    }
                </div>
            }

            <!-- Tabla de Reportes -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Código</th>
                            <th>Tipo de Evento</th>
                            <th>Sector / Quebrada</th>
                            <th>Familias</th>
                            <th>Fecha</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (misReportes == null || !misReportes.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
                                    @if (!string.IsNullOrWhiteSpace(ViewBag.BusquedaActiva) || !string.IsNullOrWhiteSpace(ViewBag.EstadoSeleccionado))
                                    {
                                        <span>No se encontraron reportes con los filtros aplicados.</span>
                                    }
                                    else
                                    {
                                        <span>No se encontraron alertas emitidas bajo su número de DNI.</span>
                                    }
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in misReportes)
                            {
                                <tr>
                                    <td class="font-monospace fw-bold text-danger">@item.CodigoIncidente</td>
                                    <td class="fw-bold">@item.TipoEvento</td>
                                    <td>@item.SectorCritico</td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark">@item.FamiliasAfectadas</span>
                                    </td>
                                    <td class="small">@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">
                                        <span class="badge @(item.Estado == "Reportado" ? "bg-warning text-dark" : item.Estado == "Desestimado" ? "bg-secondary" : "bg-success")">
                                            @item.Estado
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Seguimiento" asp-route-codigo="@item.CodigoIncidente" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-activity"></i> Ver Estado
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Resumen -->
            @if (misReportes != null && misReportes.Any())
            {
                <div class="card-footer bg-light text-muted small py-2 px-4">
                    <i class="bi bi-info-circle me-1"></i>
                    Total: <strong>@misReportes.Count()</strong> reporte(s) encontrado(s)
                </div>
            }
        </div>
    }
</div>

<!-- MODAL REPORTAR EMERGENCIA (Solo accesible para usuarios no logueados en el Portal) -->
@if (!estaLogueado)
{
    <div class="modal fade" id="modalReportarEmergencia" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow border-0">
                <form asp-controller="Incidentes" asp-action="Registrar" method="post" id="formReporteModal">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-danger text-white py-3">
                        <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Reportar Emergencia Ciudadana</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <h6 class="fw-bold text-secondary border-bottom pb-2 mb-3">1. Datos del Informante</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">DNI (8 dígitos) *</label>
                                <input type="text" name="DniCiudadano" id="modalDni" class="form-control" maxlength="8" placeholder="43243516" required />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small fw-bold">Nombre Completo *</label>
                                <input type="text" name="NombreCiudadano" class="form-control" placeholder="Nombres y Apellidos" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold">Teléfono *</label>
                                <input type="text" name="Telefono" class="form-control" maxlength="9" placeholder="983093027" required />
                            </div>
                        </div>

                        <h6 class="fw-bold text-secondary border-bottom pb-2 mb-3">2. Ubicación y Magnitud</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Distrito Afectado *</label>
                                <select name="DistritoId" asp-items="ViewBag.Distritos" class="form-select form-select-sm" required>
                                    <option value="">-- Seleccionar Distrito --</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Sector/Quebrada *</label>
                                <input type="text" name="SectorCritico" class="form-control form-control-sm" placeholder="Ej: Sector Gran Chimú" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Tipo de Evento *</label>
                                <select name="TipoEvento" class="form-select form-select-sm" required>
                                    <option value="Inundación Pluvial (Lluvias)">Inundación Pluvial</option>
                                    <option value="Desborde Quebrada">Desborde Quebrada</option>
                                    <option value="Colapso de Red de Desagüe">Colapso de Desagüe</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">N° Familias Afectadas *</label>
                                <input type="number" name="FamiliasAfectadas" class="form-control form-control-sm" min="1" max="5000" placeholder="10" required />
                            </div>
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label small fw-bold mb-0">Dirección/Ubicación *</label>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-0" id="btnGpsAnonimo">
                                        <i class="bi bi-geo-alt-fill"></i> Usar mi GPS actual
                                    </button>
                                </div>
                                <input type="text" name="DireccionReferencia" id="txtDireccionAnonimo" class="form-control form-control-sm" placeholder="Calle, número o coordenadas GPS" required />
                                                                
                                <div class="mt-2 text-end">
                                    <button type="button" id="btnVerMaps" class="btn btn-sm btn-outline-primary d-none">
                                        <i class="bi bi-map-fill me-1"></i> Ver ubicación en Google Maps
                                    </button>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold">Descripción Detallada *</label>
                                <textarea name="Descripcion" class="form-control form-control-sm" rows="3" placeholder="Explique la gravedad, altura del agua y daños visibles..." required></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light py-2">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger btn-sm px-4 fw-bold">
                            <i class="bi bi-send-fill me-1"></i> Registrar Alerta
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // GPS para modal anónimo
        const btnGpsAnonimo = document.getElementById("btnGpsAnonimo");
        const txtDireccionAnonimo = document.getElementById("txtDireccionAnonimo");
        const btnVerMapsAnonimo = document.getElementById("btnVerMaps");
        let ultimaLatitudAnonimo = null;
        let ultimaLongitudAnonimo = null;

        if (btnGpsAnonimo) {
            btnGpsAnonimo.addEventListener("click", function () {
                if (!navigator.geolocation) {
                    alert("Su navegador no soporta geolocalización.");
                    return;
                }

                const btn = this;
                const textoOriginal = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Obteniendo GPS...';

                navigator.geolocation.getCurrentPosition(
                    (pos) => {
                        const lat = pos.coords.latitude;
                        const lng = pos.coords.longitude;
                        const precision = Math.round(pos.coords.accuracy);

                        ultimaLatitudAnonimo = lat;
                        ultimaLongitudAnonimo = lng;

                        const textoGps = `[GPS: ${lat.toFixed(6)}, ${lng.toFixed(6)} | Precisión: ±${precision}m] `;
                        txtDireccionAnonimo.value = textoGps + (txtDireccionAnonimo.value.replace(/\[GPS:.*?\]\s*/g, '') || "");

                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-check-lg"></i> GPS Capturado';
                        btn.classList.replace("btn-outline-danger", "btn-success");

                        if (btnVerMapsAnonimo) {
                            btnVerMapsAnonimo.classList.remove("d-none");
                        }
                    },
                    (err) => {
                        btn.disabled = false;
                        btn.innerHTML = textoOriginal;
                        alert("No se pudo obtener la ubicación.");
                    },
                    { enableHighAccuracy: true, timeout: 12000, maximumAge: 0 }
                );
            });
        }

        if (btnVerMapsAnonimo) {
            btnVerMapsAnonimo.addEventListener("click", function () {
                if (ultimaLatitudAnonimo && ultimaLongitudAnonimo) {
                    const url = `https://www.google.com/maps?q=${ultimaLatitudAnonimo},${ultimaLongitudAnonimo}`;
                    window.open(url, '_blank');
                } else {
                    const match = txtDireccionAnonimo.value.match(/\[GPS:\s*(-?\d+\.\d+),\s*(-?\d+\.\d+)/);
                    if (match) {
                        const url = `https://www.google.com/maps?q=${match[1]},${match[2]}`;
                        window.open(url, '_blank');
                    } else {
                        alert("No hay coordenadas GPS válidas para abrir en el mapa.");
                    }
                }
            });
        }
    </script>
}

<!-- MODAL REPORTAR EMERGENCIA PARA USUARIOS LOGUEADOS -->
