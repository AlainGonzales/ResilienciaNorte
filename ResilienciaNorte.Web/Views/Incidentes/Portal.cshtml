                if (ultimaLatitudLogueado && ultimaLongitudLogueado) {
                    const url = `https://www.google.com/maps?q=${ultimaLatitudLogueado},${ultimaLongitudLogueado}`;
                    window.open(url, '_blank');
                } else {
                    const match = txtDireccionLogueado.value.match(/\[GPS:\s*(-?\d+\.\d+),\s*(-?\d+\.\d+)/);
                    if (match) {
                        const url = `https://www.google.com/maps?q=${match[1]},${match[2]}`;
                        window.open(url, '_blank');
                    } else {
                        alert("No hay coordenadas GPS válidas para abrir en el mapa.");
                    }
                }
            });
        }
    </script>
}