<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ResilienciaNorte (COEP Trujillo)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            body {
                background-color: #f4f6f9;
                font-family: 'Segoe UI', system-ui, sans-serif;
            }

            .navbar-emergency {
                background: #1a252f;
                border-bottom: 3px solid #e74c3c;
            }

            .badge-critico {
                background-color: #e74c3c;
                color: white;
            }

            .badge-alto {
                background-color: #e67e22;
                color: white;
            }

            .badge-moderado {
                background-color: #f1c40f;
                color: #2c3e50;
            }

            .card-header-resiliencia {
                background-color: #2c3e50;
                color: white;
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-emergency shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold text-uppercase d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shield-shaded text-danger fs-3 me-2"></i>
                    <span>Resiliencia<span class="text-danger">Norte</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Incidentes" asp-action="Registrar">
                                <i class="bi bi-plus-circle me-1"></i> Reportar Emergencia
                            </a>
                        </li>

                        @* SECCIONES PRIVADAS: VISIBLES SOLO PARA USUARIOS AUTENTICADOS *@
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Incidentes" asp-action="Index">
                                    <i class="bi bi-broadcast me-1"></i> Monitoreo de Incidentes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Recursos" asp-action="Index">
                                    <i class="bi bi-box-seam me-1"></i> Almacén de Contingencia (BAH)
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item text-light small me-2">
                                <i class="bi bi-person-fill text-warning"></i> @User.Identity.Name
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Cuentas" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-light py-1">
                                        <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <button type="button" class="btn btn-sm btn-outline-danger text-light fw-bold py-1 px-3" data-bs-toggle="modal" data-bs-target="#modalAuth">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                                </button>
                            </li>                            
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 pb-5">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer py-3 bg-white border-top text-center text-muted small mt-auto">
        <div class="container">
            &copy; 2026 - ResilienciaNorte | Centro de Operaciones de Emergencia Provincial (Trujillo)
        </div>
    </footer>

    <!-- 1. jQuery base -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- 2. Bootstrap Bundle local -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- 3. Scripts globales del sitio -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- 4. RenderSection de las vistas -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>