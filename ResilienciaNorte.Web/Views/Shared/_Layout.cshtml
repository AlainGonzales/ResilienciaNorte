<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ResilienciaNorte (COEP Trujillo)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            body { background-color: #f4f6f9; font-family: 'Segoe UI', system-ui, sans-serif; }
            .navbar-emergency { background: #1a252f; border-bottom: 3px solid #e74c3c; }
            .badge-critico { background-color: #e74c3c; color: white; }
            .badge-alto { background-color: #e67e22; color: white; }
            .badge-moderado { background-color: #f1c40f; color: #2c3e50; }
            .card-header-resiliencia { background-color: #2c3e50; color: white; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-emergency shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold text-uppercase d-flex align-items-center" asp-controller="Incidentes" asp-action="Index">
                    <i class="bi bi-shield-shaded text-danger fs-3 me-2"></i>
                    <span>Resiliencia<span class="text-danger">Norte</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Incidentes" asp-action="Index">
                                <i class="bi bi-broadcast me-1"></i> Monitoreo de Incidentes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Incidentes" asp-action="Registrar">
                                <i class="bi bi-plus-circle me-1"></i> Reportar Emergencia
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Recursos" asp-action="Index">
                                <i class="bi bi-box-seam me-1"></i> Almacén de Contingencia (BAH)
                            </a>
                        </li>
                    </ul>
                    <span class="navbar-text text-light small">
                        <i class="bi bi-geo-alt-fill text-warning"></i> Trujillo - Perú
                    </span>
                </div>
            </div>
        </nav>
    </header>

    <div class="container pb-5">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-3 bg-white border-top text-center text-muted small">
        <div class="container">
            &copy; 2026 - ResilienciaNorte | Centro de Operaciones de Emergencia Provincial (Trujillo)
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>