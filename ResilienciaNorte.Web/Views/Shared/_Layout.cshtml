@using Microsoft.AspNetCore.Identity
@using ResilienciaNorte.Domain
@inject UserManager<UsuarioAplicacion> UserManager

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ResilienciaNorte</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            :root {
                --sidebar-width: 320px;
                --topbar-height: 65px;
                --primary-dark: #0f172a;
                --accent-red: #dc2626;
            }

            body {
                background-color: #eff5ff;
                font-family:  'Roboto','Segoe UI', system-ui, -apple-system, sans-serif;
                color: #1e293b;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* Topbar Global */
            .topbar-app {
                height: var(--topbar-height);
                background: var(--primary-dark);
                border-bottom: 3px solid var(--accent-red);
                z-index: 1030;
            }

            /* Sidebar Operativo (Solo Funcionarios) */
            .sidebar-app {
                width: var(--sidebar-width);
                background: #ffffff;
                border-right: 1px solid #e2e8f0;
                position: fixed;
                top: var(--topbar-height);
                bottom: 0;
                left: 0;
                overflow-y: auto;
                z-index: 1020;
                padding: 1.25rem 0.85rem;
            }

            /* Ficha del Perfil en Sidebar (Estilo Adminor) */
            .sidebar-user-card {
                background: #f1f5f9;
                border: 1px solid #e2e8f0;
                border-radius: 12px;
                padding: 1rem 0.75rem;
                margin-bottom: 1.25rem;
                text-align: center;
            }

            .sidebar-user-avatar {
                width: 52px;
                height: 52px;
                background: #0f172a;
                color: #ffffff;
                border-radius: 50%;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 1.6rem;
                box-shadow: 0 2px 8px rgba(0,0,0,0.15);
                margin-bottom: 0.5rem;
            }

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 0.65rem 0.9rem;
                border-radius: 8px;
                color: #475569;
                font-weight: 500;
                text-decoration: none;
                margin-bottom: 0.25rem;
                font-size: 0.92rem;
                transition: all 0.15s ease-in-out;
            }

                .sidebar-link:hover, .sidebar-link.active {
                    background-color: #fee2e2;
                    color: var(--accent-red);
                    font-weight: 600;
                }

            /* Dropdown de Usuario en Topbar (Estilo People Success) */
            .user-dropdown-btn {
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.15);
                border-radius: 30px;
                padding: 0.35rem 0.85rem;
                color: #ffffff;
                display: inline-flex;
                align-items: center;
                gap: 0.6rem;
                transition: all 0.2s;
            }

                .user-dropdown-btn:hover, .user-dropdown-btn:focus {
                    background: rgba(255, 255, 255, 0.18);
                    color: #ffffff;
                }

            /* Contenedores de Contenido */
            .content-con-sidebar {
                margin-left: var(--sidebar-width);
                padding: 1.5rem 2rem;
                flex-grow: 1;
            }

            .content-sin-sidebar {
                padding: 1.5rem 2rem;
                flex-grow: 1;
            }

            /* Evaluador de Campo: en celular no hay menú lateral, el contenido ocupa todo el ancho */
            @@media (max-width: 767.98px) {
                .evaluador-responsive {
                    margin-left: 0;
                }
            }

            /* Celulares: márgenes de 16px para que el contenido no quede estrecho */
            @@media (max-width: 575.98px) {
                .content-sin-sidebar, .content-con-sidebar {
                    padding: 1rem;
                }
            }
        .badge-critico { background-color: #e74c3c; color: white; }
        .badge-alto { background-color: #e67e22; color: white; }
        .badge-moderado { background-color: #f1c40f; color: #2c3e50; }

        /* Modales más anchos (Bootstrap los deja en 500 px) */
        @@media (min-width: 576px) {
            .modal-dialog { max-width: 700px; }
        }
    </style>
</head>
<body>
    @{
        bool estaAutenticado = User.Identity != null && User.Identity.IsAuthenticated;
        bool esFuncionario = estaAutenticado && !User.IsInRole("Ciudadano");
        bool esAdmin = estaAutenticado && User.IsInRole("Administrador");

        // El Evaluador de Campo no navega: solo ve su triaje, sin menú lateral
        bool esEvaluadorCampo = esFuncionario && User.IsInRole("EvaluadorCampo") && !esAdmin;
        bool mostrarMenu = esFuncionario;

        // Datos del usuario obtenidos de Identity
        UsuarioAplicacion? usuarioActual = null;
        if (estaAutenticado)
        {
            usuarioActual = await UserManager.GetUserAsync(User);
        }
    }

    <!-- NAVBAR SUPERIOR -->
    <header class="topbar-app sticky-top d-flex align-items-center px-2 px-md-4 justify-content-between">
        <div class="d-flex align-items-center gap-4">
            <a class="navbar-brand text-white fw-bold d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index">
                <i class="bi bi-shield-shaded text-danger fs-3"></i>
                <span class="fs-5 fs-md-4 tracking-tight">RESILIENCIA<span class="text-danger">NORTE</span></span>
            </a>

            <!-- ENLACES SUPERIORES: VISIBLES PARA CIUDADANOS Y VISITANTES -->
            @if (!esFuncionario)
            {
                <nav class="d-flex gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-link text-white text-decoration-none px-3 d-none d-md-inline-block">
                        <i class="bi bi-house-door me-1"></i> Inicio
                    </a>
                    <a asp-controller="Incidentes" asp-action="Portal" class="btn btn-sm btn-link text-white text-decoration-none px-2 px-md-3">
                        <i class="bi bi-megaphone-fill text-warning me-1"></i><span class="d-md-none">Reporte</span><span class="d-none d-md-inline">Reporte de Emergencia</span>
                    </a>
                </nav>
            }
        </div>

        <!-- EXTREMO DERECHO: PERFIL FLOTANTE Y ENGRANAJE ADMIN (ESTILO PEOPLE SUCCESS) -->
        <div class="d-flex align-items-center gap-3">
            @if (estaAutenticado)
            {

                @* DROPDOWN DE USUARIO (CLICK PARA DESPLEGAR CERRAR SESIÓN) *@
                <div class="dropdown">
                    <button class="btn user-dropdown-btn dropdown-toggle" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="bg-danger rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" style="width: 32px; height: 32px; font-size: 0.85rem;">
                            @(usuarioActual?.NombreCompleto?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <span class="small fw-semibold d-none d-md-inline">@User.Identity.Name</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 p-2" aria-labelledby="userMenuDropdown" style="min-width: 240px; border-radius: 10px;">
                        <li class="px-3 py-2 border-bottom">
                            <span class="d-block fw-bold text-dark text-truncate">@(usuarioActual?.NombreCompleto ?? User.Identity.Name)</span>
                            <small class="text-muted d-block text-truncate">@usuarioActual?.Email</small>
                            <span class="badge bg-danger mt-1">@usuarioActual?.NivelJurisdiccion</span>
                        </li>
                        <li class="mt-2">
                            <form asp-controller="Cuentas" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2 py-2 rounded">
                                    <i class="bi bi-box-arrow-right fs-6"></i>
                                    <span>Cerrar Sesión</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <button type="button" class="btn btn-danger btn-sm px-2 px-md-3 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAuth">
                    <i class="bi bi-person-fill-lock me-1"></i><span class="d-md-none">Login</span><span class="d-none d-md-inline">Iniciar Sesión</span>
                </button>
            }
        </div>
    </header>

    <div class="d-flex flex-grow-1">
        <!-- BARRA LATERAL IZQUIERDA (SOLO FUNCIONARIOS LOGUEADOS) -->
        @if (mostrarMenu)
        {
            <aside class="sidebar-app shadow-sm @(esEvaluadorCampo ? "d-none d-md-block" : "")">
                <!-- 1. FICHA SUPERIOR DEL USUARIO (ESTILO ADMINOR) -->
                <div class="sidebar-user-card">
                    <div class="sidebar-user-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-0 text-truncate" title="@usuarioActual?.NombreCompleto">
                        @(usuarioActual?.NombreCompleto ?? "Usuario del Sistema")
                    </h6>
                    <small class="text-secondary font-monospace d-block mb-1">
                        DNI: @(usuarioActual?.Dni ?? "00000000")
                    </small>
                    <span class="badge bg-danger px-2 py-1">
                        <i class="bi bi-geo-alt-fill me-1"></i>@(usuarioActual?.NivelJurisdiccion ?? "Jurisdicción")
                    </span>
                </div>

                <!-- 2. NAVEGACIÓN Y MENÚS -->
                @{
                    var ctrlActual = ViewContext.RouteData.Values["controller"]?.ToString();
                    var accionActual = ViewContext.RouteData.Values["action"]?.ToString();
                }
                <small class="text-uppercase text-muted fw-bold px-2 d-block mb-2" style="font-size: 0.72rem; letter-spacing: 0.05em;">CENTRO DE COMANDO</small>

                @if (User.IsInRole("Administrador") || User.IsInRole("Analista"))
                {
                    <a asp-controller="Incidentes" asp-action="Index" class="sidebar-link @(ctrlActual == "Incidentes" ? "active" : "")">
                        <i class="bi bi-broadcast text-danger fs-5"></i> Monitoreo de Reportes
                    </a>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("Analista"))
                {
                    <a asp-controller="Incidencias" asp-action="Index" class="sidebar-link @(ctrlActual == "Incidencias" ? "active" : "")">
                        <i class="bi bi-collection text-danger fs-5"></i> Incidencias
                    </a>
                }

                @if (User.IsInRole("Administrador") || User.IsInRole("EvaluadorCampo"))
                {
                    <a asp-controller="Triaje" asp-action="Index" class="sidebar-link @(ctrlActual == "Triaje" ? "active" : "")">
                        <i class="bi bi-clipboard-pulse text-danger fs-5"></i> Triaje
                    </a>
                }

                @* Almacén BAH por rol: el logístico ve existencias y despachos; el coordinador, solicitudes y kardex *@
                @if (User.IsInRole("Administrador") || User.IsInRole("Coordinador"))
                {
                    <a asp-controller="Recursos" asp-action="Solicitudes" class="sidebar-link @(ctrlActual == "Recursos" && accionActual == "Solicitudes" ? "active" : "")">
                        <i class="bi bi-arrow-repeat text-danger fs-5"></i> Solicitudes
                    </a>
                    <a asp-controller="Recursos" asp-action="Kardex" class="sidebar-link @(ctrlActual == "Recursos" && accionActual == "Kardex" ? "active" : "")">
                        <i class="bi bi-journal-text text-danger fs-5"></i> Kardex
                    </a>
                }
                @if (User.IsInRole("LogisticoAlmacen"))
                {
                    <a asp-controller="Recursos" asp-action="Solicitudes" asp-route-estado="Aprobada" class="sidebar-link @(ctrlActual == "Recursos" && accionActual == "Solicitudes" ? "active" : "")">
                        <i class="bi bi-truck text-danger fs-5"></i> Despachos
                    </a>
                }
                @if (User.IsInRole("Administrador") || User.IsInRole("LogisticoAlmacen"))
                {
                    <a asp-controller="Recursos" asp-action="Index" class="sidebar-link @(ctrlActual == "Recursos" && accionActual == "Index" ? "active" : "")">
                        <i class="bi bi-box-seam text-danger fs-5"></i> Existencias
                    </a>
                }

                @if (esAdmin)
                {
                    <div class="border-top my-3"></div>
                    <small class="text-uppercase text-muted fw-bold px-2 d-block mb-2" style="font-size: 0.72rem; letter-spacing: 0.05em;">SEGURIDAD Y AUDITORÍA</small>
                    <a asp-controller="Admin" asp-action="Usuarios" class="sidebar-link @(ctrlActual == "Admin" && accionActual == "Usuarios" ? "active" : "")">
                        <i class="bi bi-shield-lock-fill text-danger fs-5"></i> Control de Usuarios
                    </a>
                    <a asp-controller="Admin" asp-action="Auditoria" class="sidebar-link @(ctrlActual == "Admin" && accionActual == "Auditoria" ? "active" : "")">
                        <i class="bi bi-shield-check text-danger fs-5"></i> Bitácora de Auditoría
                    </a>
                }
            </aside>
        }

        <!-- CONTENIDO PRINCIPAL -->
        <main class="@(esEvaluadorCampo ? "content-con-sidebar evaluador-responsive" : mostrarMenu ? "content-con-sidebar" : "content-sin-sidebar")">
            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm py-2" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            <!-- Aviso de cambios en vivo: el usuario decide cuándo actualizar, para no perder lo que tiene abierto -->
            <div id="bannerCambios" class="alert alert-info py-2 d-none d-flex justify-content-between align-items-center" role="status">
                <span><i class="bi bi-arrow-repeat me-2"></i><span id="textoBannerCambios"></span></span>
                <span class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-primary" onclick="location.reload()">Actualizar</button>
                    <button type="button" class="btn-close" aria-label="Cerrar" onclick="document.getElementById('bannerCambios').classList.add('d-none')"></button>
                </span>
            </div>
            @RenderBody()
        </main>
    </div>

    <!-- MODAL DE LOGIN / REGISTRO CIUDADANO -->
    <div class="modal fade" id="modalAuth" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-danger text-white py-2">
                    <h5 class="modal-title fs-6 fw-bold"><i class="bi bi-person-circle me-2"></i> Iniciar Sesión</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <ul class="nav nav-pills nav-justified mb-3" id="authTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active fw-bold" id="tab-login-btn" data-bs-toggle="pill" data-bs-target="#tab-login" type="button">
                                Ingresar
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold" id="tab-registro-btn" data-bs-toggle="pill" data-bs-target="#tab-registro" type="button">
                                Registrarse (Ciudadano)
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="authTabsContent">
                        <div class="tab-pane fade show active" id="tab-login">
                            <form asp-controller="Cuentas" asp-action="Login" method="post">
                                @Html.AntiForgeryToken()
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Correo Electrónico o DNI:</label>
                                    <input type="text" name="EmailODni" class="form-control form-control-sm" placeholder="admin@coep.gob.pe o 00000001" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Contraseña:</label>
                                    <input type="password" name="Password" class="form-control form-control-sm" placeholder="••••••••" required />
                                </div>
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" name="Recordarme" id="chkRecordar">
                                    <label class="form-check-label small" for="chkRecordar">Recordar sesión</label>
                                </div>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-danger fw-bold">Ingresar</button>
                                </div>
                            </form>
                        </div>

                        <div class="tab-pane fade" id="tab-registro">
                            <form asp-controller="Cuentas" asp-action="RegistroCiudadano" method="post">
                                @Html.AntiForgeryToken()
                                <div class="row g-2 mb-2">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">DNI (8 dígitos) *</label>
                                        <input type="text" name="Dni" maxlength="8" class="form-control form-control-sm" placeholder="43243516" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Celular *</label>
                                        <input type="text" name="Telefono" maxlength="9" class="form-control form-control-sm" placeholder="983093027" required />
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-bold">Nombre Completo *</label>
                                    <input type="text" name="NombreCompleto" class="form-control form-control-sm" placeholder="Nombres y Apellidos" required />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-bold">Correo Electrónico *</label>
                                    <input type="email" name="Email" class="form-control form-control-sm" placeholder="correo@ejemplo.com" required />
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Contraseña *</label>
                                        <input type="password" name="Password" class="form-control form-control-sm" placeholder="••••••" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Confirmar *</label>
                                        <input type="password" name="ConfirmPassword" class="form-control form-control-sm" placeholder="••••••" required />
                                    </div>
                                </div>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-success fw-bold"><i class="bi bi-floppy me-1"></i>Crear Cuenta Ciudadana</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPTS CON BOOTSTRAP BUNDLE (POPPER INCLUIDO PARA EL DROPDOWN) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        // Cada pantalla indica qué módulos le interesan; solo esos cambios muestran el aviso
        const modulosPantalla = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewData["ModulosTiempoReal"] as string ?? "").Split(',', System.StringSplitOptions.RemoveEmptyEntries)));
        if (modulosPantalla.length > 0) {
            const conexionOperativa = new signalR.HubConnectionBuilder()
                .withUrl("/emergenciaHub")
                .withAutomaticReconnect()
                .build();

            conexionOperativa.on("CambioOperativo", function (cambio) {
                if (!modulosPantalla.includes(cambio.modulo)) return;
                document.getElementById("textoBannerCambios").textContent = `Hay cambios recientes: ${cambio.detalle}`;
                document.getElementById("bannerCambios").classList.remove("d-none");
            });

            conexionOperativa.start().catch(err => console.error("Error al conectar SignalR operativo:", err));
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>