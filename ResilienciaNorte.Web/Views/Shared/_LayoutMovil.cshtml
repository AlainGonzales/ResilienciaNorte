<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1a252f" />
    <title>@ViewData["Title"] - ResilienciaNorte</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #eef1f5;
            font-family: 'Segoe UI', system-ui, sans-serif;
            padding-bottom: env(safe-area-inset-bottom);
        }
        .barra-movil {
            background: #1a252f;
            border-bottom: 3px solid #e74c3c;
            padding-top: env(safe-area-inset-top);
        }
        .badge-critico { background-color: #e74c3c; color: white; }
        .badge-alto { background-color: #e67e22; color: white; }
        .badge-moderado { background-color: #f1c40f; color: #2c3e50; }
    </style>
</head>
<body>
    <header class="barra-movil sticky-top shadow">
        <div class="d-flex align-items-center justify-content-between px-3 py-2">
            <span class="fw-bold text-uppercase text-white">
                <i class="bi bi-shield-shaded text-danger"></i> Resiliencia<span class="text-danger">Norte</span>
            </span>
            <span class="d-flex align-items-center gap-3">
                <span id="estadoConexion" class="small text-white-50"><i class="bi bi-circle-fill text-secondary"></i> Conectando…</span>
                <a asp-controller="Incidentes" asp-action="Index" class="text-white fs-5" title="Ir al panel provincial"><i class="bi bi-grid-fill"></i></a>
            </span>
        </div>
    </header>

    <main class="container-fluid px-3 py-3" style="max-width: 640px;">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
