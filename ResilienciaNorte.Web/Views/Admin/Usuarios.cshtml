@model IEnumerable<ResilienciaNorte.Web.Controllers.UsuarioGestionViewModel>
@{
    ViewData["Title"] = "Control de Usuarios y Permisos";
    ViewData["ModulosTiempoReal"] = "Seguridad";
    var distritos = ViewBag.Distritos as List<ResilienciaNorte.Domain.Distrito> ?? new();
    var roles = ViewBag.RolesDisponibles as List<string> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0 text-dark">
            <i class="bi bi-shield-lock-fill text-danger me-2"></i> Control de Usuarios y Seguridad RBAC
        </h3>
        <p class="text-muted small mb-0">Gestión de identidades, elevación de privilegios y asignación de jurisdicción operativa</p>
    </div>
</div>

@if (TempData["Credenciales"] != null)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-start" role="alert">
        <span><i class="bi bi-key-fill me-1"></i> <strong>Cuenta creada.</strong> Entregue estas credenciales; no se volverán a mostrar. @TempData["Credenciales"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
        <span><i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["MensajeError"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<!-- Nuevo usuario de personal: el correo y la contraseña se generan según rol y jurisdicción -->
<div class="modal fade" id="modalNuevoUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <form asp-action="CrearUsuario" method="post">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fs-6">Nuevo usuario de personal</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">El correo y la contraseña se generan según el rol y la jurisdicción. Se muestran una sola vez al crear la cuenta.</p>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">DNI *</label>
                        <input type="text" name="dni" class="form-control" required maxlength="8" pattern="\d{8}" inputmode="numeric" placeholder="8 dígitos" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Nombre completo *</label>
                        <input type="text" name="nombreCompleto" class="form-control" required maxlength="120" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Rol *</label>
                        <select name="rol" class="form-select" required>
                            <option value="Analista">Analista</option>
                            <option value="Coordinador">Coordinador</option>
                            <option value="EvaluadorCampo">Evaluador de Campo</option>
                            <option value="LogisticoAlmacen">Logístico de Almacén</option>
                            <option value="Administrador">Administrador</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Nivel jurisdiccional *</label>
                        <select name="nivel" class="form-select" required>
                            <option value="Distrital">Distrital</option>
                            <option value="Provincial">Provincial (COEP)</option>
                            <option value="Regional">Regional (COER)</option>
                        </select>
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-bold">Distrito (si es distrital)</label>
                        <select name="distritoId" class="form-select">
                            <option value="">-- No aplica --</option>
                            @foreach (var d in distritos)
                            {
                                <option value="@d.DistritoId">@d.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="bi bi-arrow-left me-1"></i>Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-person-check me-1"></i>Crear usuario</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Filtros: nivel jurisdiccional y, si es distrital, sede -->
<form method="get" class="row g-2 align-items-end mb-3" id="formFiltrosUsuarios">
    <div class="col-12 col-md-4 col-xl-3">
        <label class="form-label small fw-bold mb-1">Nivel jurisdiccional</label>
        <select name="nivel" class="form-select form-select-sm" onchange="this.form.distritoId.disabled = this.value !== 'Distrital'; this.form.submit()">
            <option value="">Todos los niveles</option>
            <option value="Distrital" selected="@(ViewBag.NivelSeleccionado == "Distrital")">Distrital</option>
            <option value="Provincial" selected="@(ViewBag.NivelSeleccionado == "Provincial")">Provincial (COEP)</option>
            <option value="Regional" selected="@(ViewBag.NivelSeleccionado == "Regional")">Regional (COER)</option>
        </select>
    </div>
    <div class="col-12 col-md-4 col-xl-3">
        <label class="form-label small fw-bold mb-1">Sede (si es distrital)</label>
        <select name="distritoId" class="form-select form-select-sm" disabled="@(ViewBag.NivelSeleccionado != "Distrital")" onchange="this.form.submit()">
            <option value="">Todas las sedes</option>
            @foreach (var d in distritos)
            {
                <option value="@d.DistritoId" selected="@((ViewBag.DistritoSeleccionado as int?) == d.DistritoId)">@d.Nombre</option>
            }
        </select>
    </div>
</form>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <span class="badge bg-danger">@Model.Count() Cuentas</span>
        <button type="button" class="btn btn-danger btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#modalNuevoUsuario">
            <i class="bi bi-person-plus-fill me-1"></i> Nuevo usuario
        </button>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark small">
                <tr>
                    <th>Usuario / Informante</th>
                    <th>Correo Electrónico</th>
                    <th>Rol Asignado</th>
                    <th>Nivel Jurisdiccional</th>
                    <th>Distrito / Sede</th>
                    <th>Estado</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-dark">@u.NombreCompleto</div>
                            <span class="badge bg-secondary font-monospace">DNI: @u.Dni</span>
                        </td>
                        <td class="small text-muted">@u.Email</td>
                        <td>
                            @switch (u.RolActual)
                            {
                                case "Administrador":
                                    <span class="badge bg-danger px-2 py-1">Administrador</span>
                                    break;
                                case "Coordinador":
                                    <span class="badge bg-primary px-2 py-1">Coordinador</span>
                                    break;
                                case "Analista":
                                    <span class="badge bg-info text-dark px-2 py-1">Analista</span>
                                    break;
                                case "LogisticoAlmacen":
                                    <span class="badge bg-success px-2 py-1">Logístico BAH</span>
                                    break;
                                case "EvaluadorCampo":
                                    <span class="badge bg-warning text-dark px-2 py-1">Evaluador Campo</span>
                                    break;
                                default:
                                    <span class="badge bg-light text-dark border px-2 py-1">Ciudadano</span>
                                    break;
                            }
                        </td>
                        <td>
                            <span class="badge bg-dark">@u.NivelJurisdiccion</span>
                        </td>
                        <td class="small">
                            @(string.IsNullOrEmpty(u.DistritoNombre) ? "Provincial / Todas" : u.DistritoNombre)
                        </td>
                        <td>
                            @if (u.Activo)
                            {
                                <span class="badge bg-success bg-opacity-75">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalEditar-@u.Id">
                                <i class="bi bi-pencil-square me-1"></i> Asignar Rol
                            </button>
                        </td>
                    </tr>

                    <!-- MODAL PARA ELEVAR DE CIUDADANO A FUNCIONARIO Y FIJAR JURISDICCIÓN -->
                    <div class="modal fade" id="modalEditar-@u.Id" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content shadow border-0">
                                <form asp-action="ActualizarPermisos" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="usuarioId" value="@u.Id" />
                                    <div class="modal-header bg-dark text-white py-2">
                                        <h6 class="modal-title">Modificar Permisos: @u.NombreCompleto</h6>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body p-4 text-start">
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Asignar Rol:</label>
                                            <select name="nuevoRol" class="form-select form-select-sm">
                                                @foreach (var r in roles)
                                                {
                                                    <!option value="@r" @(r == u.RolActual ? "selected" : "")>@r</!option>
                                                }
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Nivel Jurisdiccional:</label>
                                            <select name="nivel" class="form-select form-select-sm">
                                                <option value="Distrital" selected="@(u.NivelJurisdiccion == "Distrital")">Distrital</option>
                                                <option value="Provincial" selected="@(u.NivelJurisdiccion == "Provincial")">Provincial (COEP)</option>
                                                <option value="Regional" selected="@(u.NivelJurisdiccion == "Regional")">Regional (COER)</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Distrito Asignado (si es Distrital):</label>
                                            <select name="distritoId" class="form-select form-select-sm">
                                                <option value="">-- No aplica / Provincial o Regional --</option>
                                                @foreach (var d in distritos)
                                                {
                                                    <option value="@d.DistritoId" selected="@(u.DistritoId == d.DistritoId)">@d.Nombre</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="modal-footer bg-light py-2">
                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><i class="bi bi-arrow-left me-1"></i>Cancelar</button>
                                        <button type="submit" class="btn btn-danger btn-sm fw-bold"><i class="bi bi-floppy me-1"></i>Guardar Cambios</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
</div>