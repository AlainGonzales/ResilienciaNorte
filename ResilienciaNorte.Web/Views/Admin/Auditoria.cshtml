@model IEnumerable<ResilienciaNorte.Domain.AuditoriaSistema>
@{
    ViewData["Title"] = "Bitácora de Auditoría";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0 text-dark">
            <i class="bi bi-shield-check text-danger me-2"></i> Bitácora Inmutable de Auditoría
        </h3>
        <p class="text-muted small mb-0">Fiscalización perimetral de transacciones críticas y accesos al sistema</p>
    </div>
    <div>
        <a asp-action="Usuarios" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver a Usuarios
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 font-monospace small">
            <thead class="table-dark">
                <tr>
                    <th>Fecha / Hora (UTC)</th>
                    <th>Usuario Responsable</th>
                    <th>Módulo / Tabla</th>
                    <th>Operación</th>
                    <th>IP Origen</th>
                    <th>Detalle de Transacción</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted font-sans-serif">
                            No se han registrado eventos de auditoría hasta el momento.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>@log.FechaHoraUtc.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td class="fw-bold text-dark">@log.UsuarioId</td>
                            <td><span class="badge bg-secondary">@log.Modulo</span></td>
                            <td>
                                <span class="badge @(log.Operacion == "DELETE" ? "bg-danger" : log.Operacion == "INSERT" ? "bg-success" : "bg-warning text-dark")">
                                    @log.Operacion
                                </span>
                            </td>
                            <td>@log.IpCliente</td>
                            <td class="text-truncate" style="max-width: 350px;" title="@log.Detalle">
                                @log.Detalle
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>