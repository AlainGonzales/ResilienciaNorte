@model IEnumerable<ResilienciaNorte.Domain.AuditoriaSistema>
@{
    ViewData["Title"] = "Bitácora de Auditoría";
    ViewData["ModulosTiempoReal"] = "Seguridad,Almacen,Incidentes";
}

@section Scripts {
    <script>
        // Se filtra mientras se escribe: espera 400 ms después de la última tecla
        const inputBitacora = document.getElementById("inputBuscarBitacora");
        const formBitacora = document.getElementById("formBitacora");
        let temporizadorBitacora = null;
        inputBitacora.addEventListener("input", function () {
            clearTimeout(temporizadorBitacora);
            temporizadorBitacora = setTimeout(() => formBitacora.submit(), 400);
        });
        // Tras recargar, el cursor queda al final del texto buscado
        inputBitacora.focus();
        const textoBuscado = inputBitacora.value;
        inputBitacora.value = "";
        inputBitacora.value = textoBuscado;
    </script>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0 text-dark">
            <i class="bi bi-shield-check text-danger me-2"></i> Bitácora Inmutable de Auditoría
        </h3>
        <p class="text-muted small mb-0">Fiscalización perimetral de transacciones críticas y accesos al sistema</p>
    </div>
</div>

<!-- Filtro de texto: busca en usuario, rol, operación, módulo, detalle e IP -->
<form method="get" class="mb-3" id="formBitacora">
    <input type="search" name="buscar" id="inputBuscarBitacora" value="@ViewBag.Buscar" autocomplete="off"
           class="form-control" placeholder="Buscar en la bitácora: usuario, módulo, operación, detalle, IP..." />
</form>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 font-monospace small">
            <thead class="table-dark">
                <tr>
                    <th>Fecha / Hora (UTC)</th>
                    <th>Usuario Responsable</th>
                    <th>Módulo / Tabla</th>
                    <th>Operación</th>
                    <th>IP Origen</th>
                    <th>Detalle de Transacción</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted font-sans-serif">
                            No se han registrado eventos de auditoría hasta el momento.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>@log.FechaHoraUtc.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td class="fw-bold text-dark">@log.UsuarioId</td>
                            <td><span class="badge bg-secondary">@log.Modulo</span></td>
                            <td>
                                <span class="badge @(log.Operacion == "DELETE" ? "bg-danger" : log.Operacion == "INSERT" ? "bg-success" : "bg-warning text-dark")">
                                    @log.Operacion
                                </span>
                            </td>
                            <td>@log.IpCliente</td>
                            <td class="text-break" style="min-width: 480px;">
                                @log.Detalle
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>